import { Button, FrameFace, GraphicalSets, LabelFace, Styles, TextField } from "@widgets";
import { Dropdown, PickList } from "controls.slint";

// One open, joinable world from the login service's registry.
export struct OnlineWorldRow {
    id: string,
    name: string,
}

// A public Factorio-style server browser. Authentication is only required
// after Join; the world list itself is a public GET /v1/worlds.
export component ServerBrowser {
    in property <[OnlineWorldRow]> worlds;
    in property <[string]> names;
    in property <[string]> regions;
    in-out property <int> region: -1;
    in-out property <string> search;
    in-out property <int> selected: -1;
    in property <string> region-name;
    in property <string> account;
    in property <string> error;
    in property <string> status;
    in property <bool> busy;

    callback region-chosen(int);
    callback search-edited(string);
    callback select(int);
    callback join(string);
    callback refresh();
    callback back();

    property <bool> has-selection: root.selected >= 0 && root.selected < root.worlds.length;
    property <OnlineWorldRow> current: root.has-selection
        ? root.worlds[root.selected]
        : { id: "", name: "" };
    property <length> gap: 12px;
    property <length> bar-height: 32px;
    out property <string> empty-line: root.busy
        ? "Fetching the world list\u{2026}"
        : "No worlds are open in this region right now";

    out property <length> row-x: list.absolute-position.x + list.width / 2;
    out property <length> row0-y: list.absolute-position.y + list.first-item-y + list.row-height / 2;
    out property <length> row-pitch: list.row-height;
    out property <length> region-x: region-box.absolute-position.x + region-box.width / 2;
    out property <length> region-y: region-box.absolute-position.y + region-box.height / 2;
    out property <length> join-x: join-btn.absolute-position.x + join-btn.width / 2;
    out property <length> join-y: join-btn.absolute-position.y + join-btn.height / 2;
    out property <length> refresh-x: refresh-btn.absolute-position.x + refresh-btn.width / 2;
    out property <length> refresh-y: refresh-btn.absolute-position.y + refresh-btn.height / 2;
    out property <length> back-x: back-btn.absolute-position.x + back-btn.width / 2;
    out property <length> back-y: back-btn.absolute-position.y + back-btn.height / 2;

    frame := FrameFace {
        title: "Multiplayer";
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        property <length> left: self.content-x;
        property <length> right: self.content-right;
        property <length> top: self.content-y;
        property <length> bottom: self.height - Styles.frame.box.padding.bottom - GraphicalSets.inset(Styles.frame.graphics).bottom;
        property <length> body-top: self.top + 44px;
        property <length> body-bottom: self.bottom - root.bar-height - root.gap;
        property <length> split: self.left + (self.right - self.left) * 0.58;

        LabelFace {
            x: frame.left;
            y: frame.top;
            width: 56px;
            height: root.bar-height;
            text: "Search";
        }
        search-field := TextField {
            x: frame.left + 62px;
            y: frame.top;
            width: min(258px, frame.split - self.x - root.gap);
            height: self.preferred-height;
            text <=> root.search;
            accepted(text) => { root.search-edited(text); }
        }
        LabelFace {
            x: frame.right - 280px;
            y: frame.top;
            width: 64px;
            height: root.bar-height;
            text: "Region";
        }
        region-box := Dropdown {
            x: frame.right - 210px;
            y: frame.top + (root.bar-height - self.preferred-height) / 2;
            width: 210px;
            height: self.preferred-height;
            items: root.regions;
            selected <=> root.region;
            chosen(i) => { root.region-chosen(i); }
        }
        list := PickList {
            x: frame.left;
            y: frame.body-top + 28px;
            width: frame.split - frame.left;
            height: frame.body-bottom - self.y;
            items: root.names;
            selected <=> root.selected;
            picked(i) => {
                root.selected = i;
                root.select(i);
            }
            activated(i) => {
                root.selected = i;
                root.select(i);
                root.join(root.worlds[i].id);
            }
        }
        LabelFace {
            x: frame.left;
            y: frame.body-top;
            width: list.width;
            height: 24px;
            text: "Name";
        }
        if root.worlds.length == 0: LabelFace {
            x: list.x + 8px;
            y: list.y + 8px;
            width: list.width - 16px;
            height: 28px;
            style: Styles.caption-label;
            text: root.empty-line;
        }

        LabelFace {
            x: frame.split + root.gap;
            y: frame.body-top;
            width: frame.right - self.x;
            height: 32px;
            style: Styles.semibold-label;
            text: root.has-selection ? root.current.name : "";
        }
        LabelFace {
            x: frame.split + root.gap;
            y: frame.body-top + 40px;
            width: frame.right - self.x;
            height: 24px;
            style: Styles.caption-label;
            text: root.has-selection ? root.current.id : "";
        }
        LabelFace {
            x: frame.split + root.gap;
            y: frame.body-top + 68px;
            width: frame.right - self.x;
            height: 24px;
            style: Styles.caption-label;
            text: root.region-name;
        }
        LabelFace {
            x: frame.split + root.gap;
            y: frame.body-top + 108px;
            width: frame.right - self.x;
            height: 52px;
            style: Styles.caption-label;
            text: root.account == ""
                ? "You will be asked to sign in when you join."
                : "Signed in as " + root.account;
        }
        LabelFace {
            x: frame.split + root.gap;
            y: frame.body-bottom - 36px;
            width: frame.right - self.x;
            height: 28px;
            style: root.error != "" ? Styles.bold-red-label : Styles.caption-label;
            text: root.error != "" ? root.error : root.status;
        }

        back-btn := Button {
            x: frame.left;
            y: frame.bottom - root.bar-height;
            width: 140px;
            height: root.bar-height;
            style: Styles.back-button;
            text: "Back";
            clicked => { root.back(); }
        }
        refresh-btn := Button {
            x: frame.right - 300px - root.gap;
            y: back-btn.y;
            width: 140px;
            height: root.bar-height;
            text: "Refresh";
            enabled: !root.busy;
            clicked => { root.refresh(); }
        }
        join-btn := Button {
            x: frame.right - 150px;
            y: back-btn.y;
            width: 150px;
            height: root.bar-height;
            style: Styles.confirm-button;
            text: "Join";
            enabled: root.has-selection && !root.busy;
            clicked => { root.join(root.current.id); }
        }
    }
}
