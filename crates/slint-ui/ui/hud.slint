// The pass-through HUD: drawn over the 3D view below the interactive game UI
// and never fed input (crates/client/src/renderer/slint_overlay.rs
// `HudLayerPlugin`), so the view underneath keeps the pointer even over
// these pixels. Sizes the client also uses are in `HudConfig`; the client
// asserts they match its constants.
import { GameTheme } from "theme.slint";
import { FrameFace, GraphicalSets, GraphicalSetView, LabelFace, Styles } from "@widgets";
import { InventoryConfig, ItemSlot, SlotCell, SlotPalette } from "inventory.slint";
import { ChatConfig, ChatLines, ChatRow } from "chat.slint";

export global HudConfig {
    out property <length> crosshair-arm: 16px;
    out property <length> crosshair-width: 2px;
    // `MINIMAP_SIZE_PX` / `MINIMAP_MARGIN_PX` in commander/minimap.rs.
    out property <length> minimap-size: 220px;
    out property <length> minimap-margin: 12px;
    out property <length> minimap-outline: 2px;
    out property <length> mining-bar-width: 48px;
    out property <length> mining-bar-height: 6px;
    // The hotbar's frame around its slots.
    out property <length> hotbar-pad: 8px;
}

export component HudUi inherits Window {
    init => {
        GameTheme.apply();
    }
    background: transparent;

    // First person, while the cursor is locked for mouse look.
    in property <bool> crosshair-visible;

    // Adventure first person: the hotbar strip (bottom centre, 9 slots, the
    // selected one highlighted) and the mining progress ring around the
    // crosshair (0..1; 0 = not mining).
    in property <[ItemSlot]> hotbar;
    in property <int> hotbar-selected;
    in property <float> mining-progress;

    // The selection frame slides to the selected slot instead of jumping.
    // `hotbar-frame` is its place in slots, UNWRAPPED: a step across either
    // end of the strip (the wheel wraps the selection) keeps going in the
    // same direction, so the frame leaves by one end and comes in at the
    // other rather than running back across all the slots.
    private property <int> hotbar-prev;
    private property <int> hotbar-turns;
    private property <float> hotbar-frame;
    animate hotbar-frame {
        duration: 140ms;
        easing: ease-out;
    }
    // The frame's place within the strip, `0 ..< columns`.
    private property <float> hotbar-frame-at: Math.mod(Math.mod(root.hotbar-frame, InventoryConfig.columns) + InventoryConfig.columns, InventoryConfig.columns);
    changed hotbar-selected => {
        if (root.hotbar-selected - root.hotbar-prev == InventoryConfig.columns - 1) {
            root.hotbar-turns -= 1;
        } else if (root.hotbar-prev - root.hotbar-selected == InventoryConfig.columns - 1) {
            root.hotbar-turns += 1;
        }
        root.hotbar-prev = root.hotbar-selected;
        root.hotbar-frame = root.hotbar-selected + root.hotbar-turns * InventoryConfig.columns;
    }

    // Commander box selection, window logical pixels.
    in property <bool> band-visible;
    in property <length> band-x;
    in property <length> band-y;
    in property <length> band-width;
    in property <length> band-height;

    // The minimap: the client draws the map under this layer into the square (`renderer/map`); this
    // draws its outline and the entity/footprint overlay over it.
    in property <bool> minimap-visible;
    in property <image> minimap-overlay;
    // UI pixels per window logical pixel (the interface scale in effect).
    // The minimap stays `HudConfig`'s size in WINDOW pixels at every scale:
    // the client hit-tests it there (commander/minimap.rs `screen_rect`).
    in property <float> ui-scale: 1;
    private property <length> map-size: HudConfig.minimap-size / root.ui-scale;
    private property <length> map-margin: HudConfig.minimap-margin / root.ui-scale;

    // What the player looks at (`look_target.rs`): the pane's title ("" = no
    // pane) and its lines.
    in property <string> look-title;
    in property <[string]> look-lines;

    // The chat's newest lines while its box is closed (the client drops each
    // after a few seconds), where the box opens.
    in property <[ChatRow]> chat-recent;

    if root.chat-recent.length > 0: Rectangle {
        x: ChatConfig.left;
        y: root.height - self.height - ChatConfig.bottom;
        width: min(root.width * 0.4, ChatConfig.max-width);
        height: recent.preferred-height + 2 * ChatConfig.pad;
        background: rgba(0, 0, 0, 0.45);

        recent := ChatLines {
            x: ChatConfig.pad;
            y: ChatConfig.pad;
            width: parent.width - 2 * ChatConfig.pad;
            height: self.preferred-height;
            lines: root.chat-recent;
        }
    }

    if root.minimap-visible: Rectangle {
        // The outline, outside the map.
        x: root.map-margin - HudConfig.minimap-outline;
        y: root.height - root.map-margin - root.map-size - HudConfig.minimap-outline;
        width: root.map-size + 2 * HudConfig.minimap-outline;
        height: self.width;
        // A border only: the map shows through the square inside it.
        border-width: HudConfig.minimap-outline;
        border-color: rgba(0, 0, 0, 0.8);

        Rectangle {
            x: HudConfig.minimap-outline;
            y: HudConfig.minimap-outline;
            width: root.map-size;
            height: root.map-size;
            // Transparent: the map shows through (the HUD is pass-through, so no pointer to keep).
            background: transparent;

            Image {
                width: parent.width;
                height: parent.height;
                source: root.minimap-overlay;
                image-fit: fill;
                image-rendering: pixelated;
            }
        }
    }

    if root.band-visible: Rectangle {
        x: root.band-x;
        y: root.band-y;
        width: root.band-width;
        height: root.band-height;
        background: rgba(102, 255, 102, 0.12);
        border-width: 1px;
        border-color: rgba(102, 255, 102, 0.9);
    }

    if root.crosshair-visible: Rectangle {
        x: (root.width - HudConfig.crosshair-arm) / 2;
        y: (root.height - HudConfig.crosshair-arm) / 2;
        width: HudConfig.crosshair-arm;
        height: HudConfig.crosshair-arm;

        Rectangle {
            y: (parent.height - HudConfig.crosshair-width) / 2;
            height: HudConfig.crosshair-width;
            background: white;
        }

        Rectangle {
            x: (parent.width - HudConfig.crosshair-width) / 2;
            width: HudConfig.crosshair-width;
            background: white;
        }
    }

    if root.hotbar.length > 0: Rectangle {
        width: root.hotbar.length * (InventoryConfig.slot-size + InventoryConfig.slot-gap) - InventoryConfig.slot-gap;
        height: InventoryConfig.slot-size;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 4px - HudConfig.hotbar-pad;
        // The frame the strip is set in: it shows around the slots and
        // between them, as the inventory window does around its own.
        GraphicalSetView {
            x: -HudConfig.hotbar-pad;
            y: -HudConfig.hotbar-pad;
            width: parent.width + 2 * HudConfig.hotbar-pad;
            height: parent.height + 2 * HudConfig.hotbar-pad;
            set: Styles.frame.graphics;
        }

        // Each slot under the digit key that selects it.
        for slot[i] in root.hotbar: SlotCell {
            x: i * (InventoryConfig.slot-size + InventoryConfig.slot-gap);
            y: 0px;
            slot: slot;
            hint: i + 1;
            interactive: false;
        }

        // The frame crossing an end is cut off at the strip's edge.
        Rectangle {
            clip: true;
            // The frame, and its copy one strip to the left: while the frame
            // hangs over the right end, the copy is the part coming in at the left.
            for copy in 2: Rectangle {
                x: (root.hotbar-frame-at - copy * InventoryConfig.columns) * (InventoryConfig.slot-size + InventoryConfig.slot-gap);
                y: 0px;
                width: InventoryConfig.slot-size;
                height: InventoryConfig.slot-size;
                border-width: 3px;
                border-color: SlotPalette.selected;
            }
        }
    }

    // Mining progress: a bar under the crosshair that fills as the block
    // gives (a ring cannot be stroked with the software renderer's shapes).
    if root.mining-progress > 0: Rectangle {
        width: HudConfig.mining-bar-width;
        height: HudConfig.mining-bar-height;
        x: (root.width - self.width) / 2;
        y: root.height / 2 + HudConfig.crosshair-arm;
        background: rgba(0, 0, 0, 0.6);

        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.mining-progress, 0, 1);
            background: rgb(255, 215, 90);
        }
    }

    // Bottom right: what is under the crosshair.
    if root.look-title != "": look := FrameFace {
        property <length> line-height: 22px;
        title: root.look-title;
        width: 260px;
        height: self.content-y + root.look-lines.length * self.line-height + 4px + Styles.frame.box.padding.bottom
            + GraphicalSets.inset(Styles.frame.graphics).bottom;
        x: root.width - self.width - 12px;
        y: root.height - self.height - 12px;
        for line[i] in root.look-lines: LabelFace {
            x: look.content-x;
            y: look.content-y + i * look.line-height;
            width: look.content-right - look.content-x;
            height: look.line-height;
            text: line;
        }
    }
}
