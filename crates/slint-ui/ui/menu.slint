import { Button, FrameFace, GraphicalSets, Styles, VerticalFlow } from "@widgets";

// The in-game menu (Esc). It pauses nothing: the sim keeps running under it.
export component GameMenu {
    callback open-map();
    callback close-menu();
    // Leave the world for the main menu (stops a local server).
    callback main-menu();
    // Give up the fortress; the arrival map opens to embark or return.
    callback retire();
    // Whether the player has a fortress to retire.
    in property <bool> can-retire;
    // End the adventure; the arrival map opens again.
    callback end-adventure();
    // Whether the player is on an adventure (shown in place of Retire).
    in property <bool> can-end-adventure;
    // Whether this client can leave to a main menu (not on wasm).
    in property <bool> can-leave: true;
    // Before the first Play (the arrival map is modal): only Main menu.
    in property <bool> leave-only;
    out property <length> main-menu-button-x: main-slot.absolute-position.x + main-slot.width / 2;
    out property <length> main-menu-button-y: main-slot.absolute-position.y + main-slot.height / 2;
    out property <length> end-adventure-button-x: end-slot.absolute-position.x + end-slot.width / 2;
    out property <length> end-adventure-button-y: end-slot.absolute-position.y + end-slot.height / 2;

    menu := FrameFace {
        title: "Menu";
        width: max(160px, self.content-x + body.preferred-width + Styles.frame.box.padding.right
            + GraphicalSets.inset(Styles.frame.graphics).right);
        height: self.content-y + body.preferred-height + Styles.frame.box.padding.bottom
            + GraphicalSets.inset(Styles.frame.graphics).bottom;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        body := VerticalFlow {
            x: menu.content-x;
            y: menu.content-y;
            width: menu.content-right - menu.content-x;

            if !root.leave-only: Button {
                text: "World Map";
                clicked => { root.open-map(); }
            }
            if !root.leave-only && root.can-retire: Button {
                text: "Retire fortress";
                clicked => { root.retire(); }
            }
            end-slot := VerticalLayout {
                if !root.leave-only && root.can-end-adventure: Button {
                    text: "End adventure";
                    clicked => { root.end-adventure(); }
                }
            }
            main-slot := VerticalLayout {
                if root.can-leave: Button {
                    text: "Main menu";
                    clicked => { root.main-menu(); }
                }
            }
            if !root.leave-only: Button {
                text: "Close";
                clicked => { root.close-menu(); }
            }
        }
    }
}
