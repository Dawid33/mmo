import { Button, Checkbox, FrameFace, GraphicalSets, HorizontalFlow, LabelFace, Styles, VerticalFlow } from "@widgets";
import { PickList, Slider } from "controls.slint";

// The asset viewer (`crates/client/examples/asset_viewer.rs`): every
// Blockbench model on the left, the picked one's animations on the right,
// the model itself in the 3D view between them. Transparent elsewhere, so
// the pointer reaches the view (orbit, zoom).
export component AssetViewerUi inherits Window {
    background: transparent;

    // Paths of every .bbmodel found, relative to the repo root.
    in property <[string]> models;
    in property <int> selected-model: -1;
    // The picked model's clips, "(rest pose)" first.
    in property <[string]> clips;
    in property <int> selected-clip: -1;
    // "walk — loop, 1.20 s"
    in property <string> clip-info;
    in property <float> time;
    in property <float> length;
    in property <bool> paused;
    in property <string> speed;
    in-out property <bool> turntable: true;
    // Nodes, parts, bounds, reader warnings: one line each.
    in property <[string]> model-info;
    in property <string> status;

    callback pick-model(int);
    callback pick-clip(int);
    callback rescan();
    callback toggle-pause();
    callback restart();
    callback scrub(float);
    // ×2 or ×0.5.
    callback change-speed(float);

    property <length> margin: 12px;
    property <length> frame-bottom-pad: Styles.frame.box.padding.bottom + GraphicalSets.inset(Styles.frame.graphics).bottom;

    models-frame := FrameFace {
        title: "Models (" + root.models.length + ")";
        x: root.margin;
        y: root.margin;
        width: 320px;
        height: root.height - 2 * root.margin;

        property <length> bottom: self.height - root.frame-bottom-pad;

        // The list fills the frame down to the footer.
        PickList {
            x: models-frame.content-x;
            y: models-frame.content-y;
            width: models-frame.content-right - models-frame.content-x;
            height: models-frame.bottom - self.y - footer.preferred-height;
            items: root.models;
            selected: root.selected-model;
            picked(i) => { root.pick-model(i); }
        }
        footer := VerticalFlow {
            x: models-frame.content-x;
            y: models-frame.bottom - self.preferred-height;
            width: models-frame.content-right - models-frame.content-x;

            HorizontalFlow {
                Button {
                    text: "Rescan";
                    clicked => { root.rescan(); }
                }
            }
            if root.status != "": LabelFace {
                style: Styles.caption-label;
                text: root.status;
            }
        }
    }

    anim-frame := FrameFace {
        title: "Animations";
        x: root.width - self.width - root.margin;
        y: root.margin;
        width: 280px;
        height: root.height - 2 * root.margin;

        VerticalFlow {
            x: anim-frame.content-x;
            y: anim-frame.content-y;
            width: anim-frame.content-right - anim-frame.content-x;
            height: anim-frame.height - anim-frame.content-y - root.frame-bottom-pad;

            PickList {
                height: min(self.natural-height, anim-frame.height / 2);
                items: root.clips;
                selected: root.selected-clip;
                picked(i) => { root.pick-clip(i); }
            }
            LabelFace { text: root.clip-info; }
            Slider {
                value: root.time;
                maximum: root.length;
                disabled: root.length <= 0;
                edited(t) => { root.scrub(t); }
            }
            LabelFace {
                style: Styles.caption-label;
                text: round(root.time * 100) / 100 + " / " + round(root.length * 100) / 100 + " s   speed " + root.speed;
            }
            HorizontalFlow {
                Button {
                    text: root.paused ? "Play" : "Pause";
                    clicked => { root.toggle-pause(); }
                }
                Button {
                    text: "Restart";
                    clicked => { root.restart(); }
                }
            }
            HorizontalFlow {
                Button {
                    text: "Slower";
                    clicked => { root.change-speed(0.5); }
                }
                Button {
                    text: "Faster";
                    clicked => { root.change-speed(2.0); }
                }
            }
            Checkbox {
                text: "Turntable";
                checked <=> root.turntable;
            }
            for line in root.model-info: LabelFace {
                style: Styles.caption-label;
                text: line;
            }
        }
    }
}
