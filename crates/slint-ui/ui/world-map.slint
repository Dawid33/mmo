import { Button, FrameFace, LabelFace, Styles, VerticalFlow } from "@widgets";

// One marker on the map, placed by the client in the view's own logical pixels (the client owns
// the map's transform: Slint never scales a map picture). A frame (`border` > 0, no `fill`) or a
// filled square.
export struct MapMarker {
    x: length,
    y: length,
    w: length,
    h: length,
    color: color,
    fill: bool,
    border: length,
    label: string,
}

// The map window's tunables. Exported to Rust (`WorldMapConfig`) so the
// client and the tests share them.
export global WorldMapConfig {
    // Matches the client's `WHEEL_LINE_PX`.
    out property <length> wheel-notch: 40px;
    // A press that moves further than this is a drag (pan), not a click.
    out property <length> drag-slop: 4px;
    // Between the window edge and the map window, in play (`WorldMap.margin`).
    out property <length> margin: 24px;
    out property <length> side-width: 260px;
    // The side panel's frame around its content.
    out property <length> side-frame: 28px;
    // Between the map and the side panel.
    out property <length> gap: 8px;
    out property <color> hover-color: #ffffffa0;
    out property <color> selected-color: #ffd23c;
    out property <color> home-color: #3cc8ff;
    out property <color> view-background: #1a1a1a;
    out property <color> view-border: #000000;
    // The map view's fill: the map is drawn UNDER this layer (`renderer/map/pass.rs`), so the view
    // must show it through — but a pixel with alpha 0 does not take the pointer
    // (`Overlay::opaque_at`), so it is alpha 1 of 255: invisible, and still the layer's.
    out property <color> hole: #00000001;
}

// Reusable world-map page for the arrival screen and the inventory's Map tab.
// The client draws the map itself under this layer into the view's rect
// (the "hole"), while this page owns pan, zoom, selection and controls.
export component WorldMap {
    // The layer buttons' captions; `map-layer` indexes them (0 = default).
    in property <[string]> layer-names;
    in-out property <int> map-layer;
    in property <bool> map-available;
    // The selected region's tile (column, row on the world map); -1 = none.
    in-out property <int> selected-col: -1;
    in-out property <int> selected-row: -1;
    in property <[string]> tile-lines;
    // Block, region and height under the pointer ("" off the map).
    in property <string> pointer-line;
    in property <string> map-status;
    // Over the map, in the view's logical pixels (the client's transform).
    in property <[MapMarker]> markers;
    // Room kept free at the window's left for the arrival panel.
    in property <length> reserve-left: 0px;
    // The pointer over the view (view logical pixels), for the client's readout.
    out property <bool> pointer-in: touch.has-hover;
    out property <length> pointer-x: touch.mouse-x;
    out property <length> pointer-y: touch.mouse-y;
    // The arrival map (not in play yet): the start screen, so there is no
    // Close button but Main menu in its place. (Esc / M are the client's,
    // which honours it too.)
    in property <bool> map-modal;
    // The start screen (`map-modal`) fills the window; the map opened in play
    // is a window over the world.
    out property <length> margin: root.map-modal ? 0px : WorldMapConfig.margin;
    // Whether the start screen offers Main menu (not on wasm).
    in property <bool> can-leave: true;
    // An embedded owner (the inventory) closes with Escape instead.
    in property <bool> show-close: !root.map-modal;

    // A drag moved by (dx, dy) view logical pixels since its last report.
    callback map-drag(length, length);
    // A wheel notch (+1 in, -1 out) at (x, y) in the view.
    callback map-wheel(length, length, float);
    // A click (not a drag) at (x, y) in the view.
    callback map-click(length, length);
    callback close-map();
    // Leave the world for the main menu (the start screen's way back).
    callback main-menu();

    // The map view's top-left, in window logical pixels: hit-test positions
    // for headless tests.
    out property <length> view-x: view.absolute-position.x;
    out property <length> view-y: view.absolute-position.y;
    // The view's size: the client centres the pan on the home tile with it.
    out property <length> view-width: view.width;
    out property <length> view-height: view.height;
    // Close (Main menu while `map-modal`) sits under the tile lines.
    out property <length> close-button-x: close-slot.absolute-position.x + close-slot.width / 2;
    out property <length> close-button-y: close-slot.absolute-position.y + close-slot.height / 2;
    // The layer buttons: a column, button `i`'s centre at
    // (`layer-button-x`, `layer-buttons-top + (i + 0.5) * layer-button-pitch`).
    out property <length> layer-button-x: layers.absolute-position.x + layers.width / 2;
    out property <length> layer-buttons-top: layers.absolute-position.y;
    out property <length> layer-button-pitch: layers.height / max(1, root.layer-names.length);

    // Pointer position at the press / last report, and whether the press became a drag.
    property <length> last-x;
    property <length> last-y;
    property <bool> dragged;
    // Scroll not yet worth a notch (touchpads scroll in small steps).
    property <length> wheel-acc;
    // The side panel's frame width.
    property <length> side-frame-width: min(
        WorldMapConfig.side-width + WorldMapConfig.side-frame,
        root.width * 0.45
    );

    view := Rectangle {
        x: root.margin + root.reserve-left;
        y: root.margin;
        width: max(0px, root.width - 2 * root.margin - root.reserve-left - root.side-frame-width - WorldMapConfig.gap);
        height: max(0px, root.height - 2 * root.margin);
        clip: true;
        background: root.map-available ? WorldMapConfig.hole : WorldMapConfig.view-background;

        for m in root.markers: Rectangle {
            x: m.x;
            y: m.y;
            width: m.w;
            height: m.h;
            background: m.fill ? m.color : transparent;
            border-width: m.border;
            border-color: m.color;
        }
        if !root.map-available: LabelFace {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: self.preferred-width;
            height: self.preferred-height;
            text: "No world map (procedural world)";
        }

        touch := TouchArea {
            enabled: root.map-available;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.last-x = self.mouse-x;
                    root.last-y = self.mouse-y;
                    root.dragged = false;
                }
                // A drag released (or cancelled) outside the view gets
                // no `clicked`: end it here. `clicked` runs before `up`,
                // so it still sees the drag.
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up)
                    || event.kind == PointerEventKind.cancel {
                    root.dragged = false;
                }
            }
            moved => {
                if self.pressed {
                    if !root.dragged && (abs(self.mouse-x - self.pressed-x) > WorldMapConfig.drag-slop
                        || abs(self.mouse-y - self.pressed-y) > WorldMapConfig.drag-slop) {
                        root.dragged = true;
                    }
                    if root.dragged {
                        root.map-drag(self.mouse-x - root.last-x, self.mouse-y - root.last-y);
                        root.last-x = self.mouse-x;
                        root.last-y = self.mouse-y;
                    }
                }
            }
            clicked => {
                if !root.dragged {
                    root.map-click(self.pressed-x, self.pressed-y);
                }
                root.dragged = false;
            }
            scroll-event(event) => {
                if event.delta-y == 0 {
                    return reject;
                }
                root.wheel-acc += event.delta-y;
                if abs(root.wheel-acc) < WorldMapConfig.wheel-notch {
                    return accept;
                }
                root.map-wheel(self.mouse-x, self.mouse-y, root.wheel-acc > 0 ? 1 : -1);
                root.wheel-acc = 0;
                accept
            }
        }
    }
    // The view's edge, over the map and the markers.
    Rectangle {
        x: view.x;
        y: view.y;
        width: view.width;
        height: view.height;
        border-width: 2px;
        border-color: WorldMapConfig.view-border;
    }

    window := FrameFace {
        title: "World Map";
        x: view.x + view.width + WorldMapConfig.gap;
        y: root.margin;
        width: root.side-frame-width;
        height: root.height - 2 * root.margin;

        side := VerticalFlow {
            x: window.content-x;
            y: window.content-y;
            width: window.content-right - window.content-x;

            layers := VerticalLayout {
                for name[i] in root.layer-names: Button {
                    text: name;
                    enabled: root.map-available;
                    toggled: i == root.map-layer;
                    clicked => { root.map-layer = i; }
                }
            }
            if root.map-available && root.selected-col < 0: LabelFace {
                style: Styles.caption-label;
                text: "Select a tile";
            }
            for line in root.tile-lines: LabelFace { text: line; }
            if root.pointer-line != "": LabelFace {
                style: Styles.caption-label;
                text: root.pointer-line;
            }
            close-slot := VerticalLayout {
                if root.show-close && !root.map-modal: Button {
                    text: "Close";
                    clicked => { root.close-map(); }
                }
                if root.map-modal && root.can-leave: Button {
                    text: "Main menu";
                    clicked => { root.main-menu(); }
                }
            }
            if root.map-status != "": LabelFace {
                style: Styles.caption-label;
                text: root.map-status;
            }
        }
    }
}
