import { Button, FrameFace, GraphicalSets, HorizontalFlow, LabelFace, RadialItem, RadialMenu, Styles, VerticalFlow } from "@widgets";
import { GameMenu } from "menu.slint";
import { WorldMap, WorldMapConfig } from "world-map.slint";

export { RadialItem, WorldMapConfig }

// The whole in-game UI: one transparent window-sized layer that the client
// draws over the 3D view (crates/client/src/renderer/slint_overlay.rs).
// Transparent pixels let the pointer through to the game.
export component GameUi inherits Window {
    background: transparent;

    in-out property <bool> panel-open: true;
    in property <string> home-region: "--";
    in property <string> connection: "--";
    in property <int> selected-count;
    // One line per selected entity kind, e.g. "Slime (size 2) ×3".
    in property <[string]> selection-lines;

    callback clear-selection();

    // Adventure mode: the client plays its one body instead of commanding
    // (crates/client/src/renderer/commander/adventure.rs). The panel button
    // switches; the fortress tools are off meanwhile (`tools-available`).
    in property <bool> adventure;
    callback toggle-mode();

    // Follow: the camera tracks the one selected entity
    // (commander/follow.rs).
    in property <bool> following;
    callback follow-clicked();

    // Fortress tools (crates/client/src/renderer/commander/designate.rs).
    // False with no home region (not joined yet).
    in property <bool> tools-available: true;
    // The active tool's index in `TOOL_KEYS` order (Dig, Deconstruct, Build,
    // Chop, Erase); -1 = none. Its wedge shows selected.
    in property <int> active-tool: -1;
    in property <int> priority: 4;
    // "Level 64 · 6 below surface"; "" until the level is known.
    in property <string> level-text;
    // The drag's size and refusals; "" when not dragging.
    in property <string> drag-text;
    // The cursor, which the drag readout sits next to.
    in property <length> drag-x;
    in property <length> drag-y;

    // The tool wheel (hold Q), which replaced the tool bar: one
    // wedge per tool in `TOOL_KEYS` order, then the cut. The client
    // opens and closes it (crates/slint-ui/src/wheel.rs) and reads
    // `wheel-hovered` to pick.
    in property <[RadialItem]> wheel-items;
    in property <bool> wheel-open;
    // Its centre: where it was opened.
    in property <length> wheel-x;
    in property <length> wheel-y;
    out property <int> wheel-hovered: root.wheel-open ? wheel.hovered : -1;

    // The Esc menu and the world map (M). Neither pauses anything; the
    // client keeps them exclusive (opening the map closes the menu).
    in-out property <bool> menu-open;
    in-out property <bool> map-open;
    // The whole tile grid, `WorldMapConfig.tile-px` pixels per tile.
    in property <image> map-image;
    in property <int> map-cols;
    in property <int> map-rows;
    // False without a forged world: the map says so instead.
    in property <bool> map-available;
    // Tile coordinates on the map (column right, row down); -1 = none.
    in property <int> home-col: -1;
    in property <int> home-row: -1;
    in-out property <int> selected-col: -1;
    in-out property <int> selected-row: -1;
    // The selected tile's info, one line each.
    in property <[string]> tile-lines;
    in property <bool> play-enabled;
    // Why Play is disabled; "" when it is not.
    in property <string> play-reason;
    // "Loading region…", a refusal; "" for none.
    in property <string> map-status;
    in-out property <float> map-zoom: 1;
    in-out property <length> map-pan-x;
    in-out property <length> map-pan-y;
    // Hit-test positions for headless tests (window logical pixels): the
    // map view's top-left and the Play button's centre.
    out property <length> map-view-x: map.view-x;
    out property <length> map-view-y: map.view-y;
    out property <length> map-view-width: map.view-width;
    out property <length> map-view-height: map.view-height;
    out property <length> play-button-x: map.play-button-x;
    out property <length> play-button-y: map.play-button-y;

    callback open-map();
    callback close-menu();
    // The menu's Main menu button: leave the world.
    callback main-menu();
    // Whether the menu offers Main menu (false on wasm, which has no menu).
    in property <bool> can-leave: true;
    // Not embarked yet: the world map is the embark step. Its Close is gone,
    // the Esc menu offers only Main menu, and neither the F9 panel nor the
    // status line is drawn.
    in property <bool> map-modal;
    out property <length> close-button-x: map.close-button-x;
    out property <length> close-button-y: map.close-button-y;
    out property <length> main-menu-button-x: menu.main-menu-button-x;
    out property <length> main-menu-button-y: menu.main-menu-button-y;
    callback close-map();
    // A tile clicked on the map (it is now `selected-col/row`).
    callback select-tile(int, int);
    callback play();
    // The game-level status line ("Loading region…", a Play refusal);
    // "" draws nothing. Hidden under the open map, which shows `map-status`.
    in property <string> game-status;
    // The status line's centre (window logical pixels), for headless tests.
    out property <length> status-x: root.width / 2;
    out property <length> status-y: root.status-top + 12px;
    property <length> status-top: 12px;

    // The drag readout's distance right of and below the cursor; it flips
    // to the other side at the window edge rather than slide under it.
    property <length> drag-offset: 16px;

    // Top-right, clear of the minimap (bottom-left).
    // Not over the arrival map (nor beside its Esc menu).
    if root.panel-open && !root.map-modal: panel := FrameFace {
        title: "Fortress";
        // Wide enough for the selection row ("Stop following" is its
        // widest state).
        width: max(240px, self.content-x + selection-row.preferred-width + Styles.frame.box.padding.right
            + GraphicalSets.inset(Styles.frame.graphics).right);
        height: self.content-y + body.preferred-height + Styles.frame.box.padding.bottom
            + GraphicalSets.inset(Styles.frame.graphics).bottom;
        x: root.width - self.width - 12px;
        y: 12px;

        body := VerticalFlow {
            x: panel.content-x;
            y: panel.content-y;
            width: panel.content-right - panel.content-x;

            LabelFace { text: "Region " + root.home-region; }
            LabelFace { text: root.connection; }
            if root.level-text != "": LabelFace { text: root.level-text; }
            if root.active-tool >= 0: LabelFace {
                style: Styles.caption-label;
                text: "Priority " + root.priority + "  [1–7]";
            }
            // A flow never wraps, and the panel is pinned to the window's
            // right edge: a row wider than the panel runs off screen.
            Button {
                text: root.adventure ? "Fortress mode" : "Adventure mode";
                clicked => { root.toggle-mode(); }
            }
            LabelFace {
                style: Styles.caption-label;
                text: root.selected-count == 0 ? "Nothing selected" : "Selected: " + root.selected-count;
            }
            for line in root.selection-lines: LabelFace { text: line; }
            selection-row := HorizontalFlow {
                Button {
                    text: "Clear selection";
                    enabled: root.selected-count > 0;
                    clicked => { root.clear-selection(); }
                }
                Button {
                    text: root.following ? "Stop following" : "Follow";
                    enabled: root.selected-count == 1 || root.following;
                    clicked => { root.follow-clicked(); }
                }
            }
        }
    }

    // Next to the cursor while dragging.
    if root.drag-text != "": drag := FrameFace {
        width: self.content-x + drag-label.preferred-width + Styles.frame.box.padding.right
            + GraphicalSets.inset(Styles.frame.graphics).right;
        height: self.content-y + drag-label.preferred-height + Styles.frame.box.padding.bottom
            + GraphicalSets.inset(Styles.frame.graphics).bottom;
        x: root.drag-x + root.drag-offset + self.width <= root.width
            ? root.drag-x + root.drag-offset : root.drag-x - root.drag-offset - self.width;
        y: root.drag-y + root.drag-offset + self.height <= root.height
            ? root.drag-y + root.drag-offset : root.drag-y - root.drag-offset - self.height;

        drag-label := LabelFace {
            x: drag.content-x;
            y: drag.content-y;
            text: root.drag-text;
        }
    }

    // Top centre, apart from the F9 panel and the map window; only while
    // there is something to say, so it takes no pixels or clicks otherwise.
    if root.game-status != "" && !root.map-open && !root.map-modal: status := FrameFace {
        width: self.content-x + status-label.preferred-width + Styles.frame.box.padding.right
            + GraphicalSets.inset(Styles.frame.graphics).right;
        height: self.content-y + status-label.preferred-height + Styles.frame.box.padding.bottom
            + GraphicalSets.inset(Styles.frame.graphics).bottom;
        x: (root.width - self.width) / 2;
        y: root.status-top;

        status-label := LabelFace {
            x: status.content-x;
            y: status.content-y;
            text: root.game-status;
        }
    }

    // Centred where it was opened, and large enough to cover the window
    // from there, so the pointer aims anywhere on screen.
    wheel := RadialMenu {
        property <length> side: 2 * (root.width + root.height);
        visible: root.wheel-open;
        width: self.side;
        height: self.side;
        x: root.wheel-x - self.side / 2;
        y: root.wheel-y - self.side / 2;
        items: root.wheel-items;
        toggled: root.active-tool;
    }

    // `visible` rather than `if`, so its hit-test positions stay readable.
    menu := GameMenu {
        visible: root.menu-open;
        width: 100%;
        height: 100%;
        can-leave: root.can-leave;
        leave-only: root.map-modal;
        open-map => { root.open-map(); }
        close-menu => { root.close-menu(); }
        main-menu => { root.main-menu(); }
    }

    // Over everything else. `visible` rather than `if`, so its hit-test
    // positions above stay readable.
    map := WorldMap {
        visible: root.map-open;
        width: 100%;
        height: 100%;
        map-image: root.map-image;
        map-cols: root.map-cols;
        map-rows: root.map-rows;
        map-available: root.map-available;
        home-col: root.home-col;
        home-row: root.home-row;
        selected-col <=> root.selected-col;
        selected-row <=> root.selected-row;
        tile-lines: root.tile-lines;
        play-enabled: root.play-enabled;
        play-reason: root.play-reason;
        map-status: root.map-status;
        map-zoom <=> root.map-zoom;
        map-pan-x <=> root.map-pan-x;
        map-pan-y <=> root.map-pan-y;
        map-modal: root.map-modal;
        select-tile(col, row) => { root.select-tile(col, row); }
        play => { root.play(); }
        close-map => { root.close-map(); }
    }
}
