import { Button, FrameFace, GraphicalSets, HorizontalFlow, LabelFace, RadialItem, RadialMenu, Styles, VerticalFlow } from "@widgets";
import { GameMenu } from "menu.slint";
import { SiteMark, WorldMap, WorldMapConfig } from "world-map.slint";
import { EmbarkLayout, EmbarkPanel, EmbarkRow, LegendsFilterRow, LegendsLayout } from "embark.slint";
import { GameTheme } from "theme.slint";
import { FortressLayout, FortressPanel } from "fortress-panel.slint";
import { DevStat, DevTickRow, DevToggle } from "debug-tab.slint";
import { MenuColumn, MenuLayout } from "menu-column.slint";
import { StubWindow } from "stub-window.slint";
import { InventoryScreen, ItemSlot } from "inventory.slint";
import { ChatBox, ChatConfig, ChatRow } from "chat.slint";

export { ChatRow, ItemSlot, EmbarkRow, LegendsFilterRow, RadialItem, SiteMark, WorldMapConfig }

// The whole in-game UI: one transparent window-sized layer that the client
// draws over the 3D view (crates/client/src/renderer/slint_overlay.rs).
// Transparent pixels let the pointer through to the game.

export component GameUi inherits Window {
    init => {
        GameTheme.apply();
    }
    background: transparent;

    // The fortress panel, top left (fortress-panel.slint): key figures on the
    // tab row
    // (placeholders reading "0"), the open tab (-1 = collapsed) and the
    // tabs' contents.
    in property <string> fortress-value: "0";
    in property <string> fortress-happiness: "0";
    in property <string> fortress-food: "0";
    in-out property <int> fortress-tab: -1;
    in property <[string]> governance-lines;
    in property <[string]> people-names;
    in property <[string]> designation-lines;
    // A People row clicked (index into `people-names`).
    callback person-picked(int);
    // The fortress panel's Debug tab (index 4; `dev_ui` builds only, F3
    // opens it): stats, the debug toggles and "Complete all orders"
    // (crates/client/src/renderer/dev_ui.rs).
    in property <bool> debug-available;
    in property <[DevStat]> dev-stats;
    in property <[DevToggle]> dev-toggles;
    // Each live predicted region's tick times (dev_ui::tick_rows).
    in property <[DevTickRow]> dev-tick-rows;
    // Index into `dev-toggles`, new state.
    callback dev-toggle(int, bool);
    callback dev-complete-orders();
    callback dev-drop-body();
    out property <length> dev-toggles-x: fortress.dev-toggles-x;
    out property <length> dev-toggles-y: fortress.dev-toggles-y;
    out property <length> dev-toggle-row-height: fortress.dev-toggle-row-height;
    out property <length> dev-complete-x: fortress.dev-complete-x;
    out property <length> dev-complete-y: fortress.dev-complete-y;
    out property <length> dev-drop-x: fortress.dev-drop-x;
    out property <length> dev-drop-y: fortress.dev-drop-y;
    out property <length> dev-ticks-x: fortress.dev-ticks-x;
    out property <length> fortress-tabs-x: fortress.tabs-x;
    out property <length> fortress-tabs-y: fortress.tabs-y;
    out property <length> people-first-item-y: fortress.people-first-item-y;
    out property <length> people-row-height: fortress.people-row-height;
    out property <length> fortress-values-left: fortress.values-left;
    out property <length> fortress-values-top: fortress.values-top;
    out property <length> fortress-values-bottom: fortress.values-bottom;
    out property <length> fortress-tabs-top: fortress.tabs-top;
    out property <length> fortress-tabs-end: fortress.tabs-end;
    out property <length> fortress-tab-row-height: fortress.tab-row-height;
    out property <length> fortress-widest-label: fortress.widest-label;
    out property <length> fortress-tab-label-room: fortress.tab-label-room;
    // The fortress panel's right edge (window logical pixels).
    out property <length> fortress-panel-right: fortress.absolute-position.x + fortress.width;

    in property <int> selected-count;
    // One line per selected entity kind, e.g. "Slime (size 2) ×3".
    in property <[string]> selection-lines;

    callback clear-selection();

    // Adventure mode: the client plays its one body instead of commanding
    // (crates/client/src/renderer/commander/adventure.rs); the fortress tools
    // are off meanwhile (`tools-available`). No UI switches it for now.
    in property <bool> adventure;

    // The top-right column (menu-column.slint): Settings and Encyclopedia,
    // each a stub window for now (modal screens, like the map), and the
    // context box: the active tool (`tool-name`, "" = none) and the
    // selection.
    in-out property <bool> settings-open;
    in-out property <bool> encyclopedia-open;
    callback open-settings();
    callback open-encyclopedia();
    // Close on either stub window.
    callback close-window();
    in property <string> tool-name;
    // The open stub window's Close button (window logical pixels).
    out property <length> stub-close-x: root.encyclopedia-open ? encyclopedia.close-x : settings.close-x;
    out property <length> stub-close-y: root.encyclopedia-open ? encyclopedia.close-y : settings.close-y;

    // Follow: the camera tracks the one selected entity
    // (commander/follow.rs).
    in property <bool> following;
    callback follow-clicked();
    // The top-down view is on; its button leaves it.
    in property <bool> top-down;
    callback top-down-clicked();

    // The inventory / chest screen (inventory.slint), modal while open. The
    // sim owns whether it is open; the client mirrors it here and reports
    // slot presses as (in-container, index, right button).
    in-out property <bool> inventory-open;
    in property <[ItemSlot]> inventory-hotbar;
    in property <[ItemSlot]> inventory-main;
    // Empty = no chest open.
    in property <[ItemSlot]> inventory-container;
    in property <ItemSlot> inventory-cursor;
    in property <int> inventory-selected;
    // The pointer, UI logical pixels (the held stack follows it).
    in property <length> inventory-pointer-x;
    in property <length> inventory-pointer-y;
    callback inventory-slot-pressed(bool, int, bool);
    out property <length> inventory-grid-left: inventory.grid-left;
    out property <length> inventory-container-top: inventory.container-top;
    out property <length> inventory-main-top: inventory.main-top;
    out property <length> inventory-hotbar-top: inventory.hotbar-top;
    out property <length> inventory-slot-pitch: inventory.slot-pitch;
    out property <length> inventory-slot-size: inventory.slot-size;

    // Fortress tools (crates/client/src/renderer/commander/designate.rs).
    // False with no home region (not joined yet).
    in property <bool> tools-available: true;
    // The active tool's index in `TOOL_KEYS` order (Dig, Deconstruct, Build,
    // Chop, Erase); -1 = none. Its wedge shows selected.
    in property <int> active-tool: -1;
    in property <int> priority: 4;
    // "Level 64 · 6 below surface"; "" until the level is known.
    in property <string> level-text;
    // The drag's size and refusals; "" when not dragging.
    in property <string> drag-text;
    // The cursor, which the drag readout sits next to.
    in property <length> drag-x;
    in property <length> drag-y;

    // The tool wheel (hold Q), which replaced the tool bar: one
    // wedge per tool in `TOOL_KEYS` order, then the cut. The client
    // opens and closes it (crates/slint-ui/src/wheel.rs) and reads
    // `wheel-hovered` to pick.
    in property <[RadialItem]> wheel-items;
    in property <bool> wheel-open;
    // Its centre: where it was opened.
    in property <length> wheel-x;
    in property <length> wheel-y;
    out property <int> wheel-hovered: root.wheel-open ? wheel.hovered : -1;

    // The Esc menu and the world map (M). Neither pauses anything; the
    // client keeps them exclusive (opening the map closes the menu).
    in-out property <bool> menu-open;
    in-out property <bool> map-open;
    // The whole tile grid, `WorldMapConfig.tile-px` pixels per tile.
    in property <image> map-image;
    // The map's layer buttons (captions) and the picked one, which
    // `map-image` shows.
    in property <[string]> map-layer-names;
    in-out property <int> map-layer;
    in property <int> map-cols;
    in property <int> map-rows;
    // False without a forged world: the map says so instead.
    in property <bool> map-available;
    // Tile coordinates on the map (column right, row down); -1 = none.
    in property <int> home-col: -1;
    in property <int> home-row: -1;
    in-out property <int> selected-col: -1;
    in-out property <int> selected-row: -1;
    // The selected tile's info, one line each.
    in property <[string]> tile-lines;
    in property <bool> play-enabled;
    // Why Play is disabled; "" when it is not.
    in property <string> play-reason;
    // "Loading region…", a refusal; "" for none.
    in property <string> map-status;
    in property <[SiteMark]> map-sites;
    in property <bool> show-play: true;
    // The tile under the map pointer, and whether embarking there is refused.
    out property <int> map-hover-col: map.hover-col;
    out property <int> map-hover-row: map.hover-row;
    in property <bool> hover-blocked;
    // The embark panel (beside the map while it is visible).
    in property <bool> embark-visible;
    in property <[string]> embark-civs;
    in property <int> embark-civ-picked: -1;
    in property <[EmbarkRow]> embark-rows;
    in property <string> embark-counter;
    in property <string> embark-region;
    in property <bool> embark-enabled;
    in property <[string]> embark-returns;
    callback embark-pick-civ(int);
    callback embark-toggle-person(int, int);
    callback embark-go();
    callback embark-return-to(int);
    // The panel's open tab: 0 Fortress, 1 Adventure, 2 Legends.
    in-out property <int> embark-tab: 0;
    callback embark-tab-changed(int);
    // The Adventure tab: civs with a populated site, the picked civ's
    // populated sites ("<site> — pop N"), the picked site's region, and
    // whether Start adventure is enabled (a site picked, nothing pending).
    in property <[string]> adventure-civs;
    in property <int> adventure-civ-picked: -1;
    in property <[string]> adventure-sites;
    in property <int> adventure-site-picked: -1;
    in property <string> adventure-region;
    in property <bool> adventure-enabled;
    callback adventure-pick-civ(int);
    callback adventure-pick-site(int);
    callback adventure-start();
    // The Legends tab: the filter column ("All events", civs, their sites),
    // the picked filter, the header line, the event lines (newest first) and
    // whether older lines can be loaded (scrolling to the bottom asks).
    in property <[LegendsFilterRow]> legends-filters;
    in property <int> legends-filter-picked: 0;
    in property <string> legends-header;
    in property <[string]> legends-lines;
    in property <bool> legends-more;
    callback legends-pick-filter(int);
    callback legends-load-more();
    callback legends-line-clicked(int);
    // Hit-test positions of the embark panel for headless tests (window
    // logical pixels).
    out property <length> embark-tabs-x: embark.tabs-x;
    out property <length> embark-tabs-y: embark.tabs-y;
    out property <length> embark-tabs-end: embark.tabs-end;
    out property <length> embark-tabs-right: embark.tabs-right;
    out property <length> adventure-start-x: embark.adventure-start-x;
    out property <length> adventure-start-y: embark.adventure-start-y;
    out property <length> legends-filter-x: embark.legends-filter-x;
    out property <length> legends-filter-first-y: embark.legends-filter-first-y;
    out property <length> legends-filter-row-height: embark.legends-filter-row-height;
    in-out property <float> map-zoom: 1;
    in-out property <length> map-pan-x;
    in-out property <length> map-pan-y;
    // Hit-test positions for headless tests (window logical pixels): the
    // map view's top-left and the Play button's centre.
    out property <length> map-view-x: map.view-x;
    out property <length> map-view-y: map.view-y;
    out property <length> map-view-width: map.view-width;
    out property <length> map-view-height: map.view-height;
    out property <length> play-button-x: map.play-button-x;
    out property <length> play-button-y: map.play-button-y;
    out property <length> layer-button-x: map.layer-button-x;
    out property <length> layer-buttons-top: map.layer-buttons-top;
    out property <length> layer-button-pitch: map.layer-button-pitch;
    // The whole map in view (the client calls it when a map arrives).
    public function fit-map() {
        map.fit-map();
    }
    // Tile (`col`, `row`) of the map into view (the home tile, on opening).
    public function show-map-tile(col: int, row: int) {
        map.show-tile(col, row);
    }

    callback open-map();
    callback close-menu();
    // The menu's Main menu button: leave the world.
    callback main-menu();
    // The menu's Retire fortress button.
    callback retire();
    // Whether the menu offers Retire fortress.
    in property <bool> can-retire;
    // The menu's End adventure button, and whether it is offered (an
    // adventure is held).
    callback end-adventure();
    in property <bool> can-end-adventure;
    // Whether the menu offers Main menu (false on wasm, which has no menu).
    in property <bool> can-leave: true;
    // Not embarked yet: the world map is the embark step. Its Close is gone,
    // the Esc menu offers only Main menu, and neither the fortress panel, the
    // menu column nor the status line is drawn.
    in property <bool> map-modal;
    out property <length> close-button-x: map.close-button-x;
    out property <length> close-button-y: map.close-button-y;
    out property <length> main-menu-button-x: menu.main-menu-button-x;
    out property <length> end-adventure-button-x: menu.end-adventure-button-x;
    out property <length> end-adventure-button-y: menu.end-adventure-button-y;
    out property <length> main-menu-button-y: menu.main-menu-button-y;
    callback close-map();
    // A tile clicked on the map (it is now `selected-col/row`).
    callback select-tile(int, int);
    callback play();
    // The game-level status line ("Loading region…", a Play refusal);
    // "" draws nothing. Hidden under the open map, which shows `map-status`.
    in property <string> game-status;
    // The home server's drain countdown, shown above the status line; "" draws nothing.
    in property <string> drain-line;
    // The status line's centre (window logical pixels), for headless tests.
    out property <length> status-x: root.width / 2;
    out property <length> status-y: root.status-top + 12px;
    // Under the fortress panel's tab row, which spans the top centre.
    property <length> status-top: fortress.bar-bottom + 8px;

    // The drag readout's distance right of and below the cursor; it flips
    // to the other side at the window edge rather than slide under it.
    property <length> drag-offset: 16px;

    // Top left; not over the arrival map. `visible` on a plain Rectangle
    // (not `if`), so the test probes above stay readable.
    Rectangle {
        visible: !root.map-modal;
        fortress := FortressPanel {
            x: FortressLayout.margin;
            y: FortressLayout.margin;
            height-limit: root.height - FortressLayout.margin - FortressLayout.bottom-gap;
            value: root.fortress-value;
            happiness: root.fortress-happiness;
            food: root.fortress-food;
            tab <=> root.fortress-tab;
            governance-lines: root.governance-lines;
            people: root.people-names;
            designations: root.designation-lines;
            person-picked(i) => { root.person-picked(i); }
            debug-available: root.debug-available;
            dev-stats: root.dev-stats;
            dev-toggles: root.dev-toggles;
            dev-tick-rows: root.dev-tick-rows;
            dev-toggle(i, on) => { root.dev-toggle(i, on); }
            dev-complete-orders => { root.dev-complete-orders(); }
            dev-drop-body => { root.dev-drop-body(); }
        }
    }

    // Top right; not over the arrival map.
    if !root.map-modal: MenuColumn {
        x: root.width - self.width - MenuLayout.margin;
        y: MenuLayout.margin;
        open-settings => { root.open-settings(); }
        open-encyclopedia => { root.open-encyclopedia(); }
        tool-name: root.tool-name;
        priority: root.priority;
        level-text: root.level-text;
        selected-count: root.selected-count;
        selection-lines: root.selection-lines;
        following: root.following;
        clear-selection => { root.clear-selection(); }
        follow-clicked => { root.follow-clicked(); }
        top-down: root.top-down;
        top-down-clicked => { root.top-down-clicked(); }
    }

    // Next to the cursor while dragging.
    if root.drag-text != "": drag := FrameFace {
        width: self.content-x + drag-label.preferred-width + Styles.frame.box.padding.right
            + GraphicalSets.inset(Styles.frame.graphics).right;
        height: self.content-y + drag-label.preferred-height + Styles.frame.box.padding.bottom
            + GraphicalSets.inset(Styles.frame.graphics).bottom;
        x: root.drag-x + root.drag-offset + self.width <= root.width
            ? root.drag-x + root.drag-offset : root.drag-x - root.drag-offset - self.width;
        y: root.drag-y + root.drag-offset + self.height <= root.height
            ? root.drag-y + root.drag-offset : root.drag-y - root.drag-offset - self.height;

        drag-label := LabelFace {
            x: drag.content-x;
            y: drag.content-y;
            text: root.drag-text;
        }
    }

    // Top centre, between the fortress panel and the menu column, apart from
    // the map window; only while
    // there is something to say, so it takes no pixels or clicks otherwise.
    // Above the status line (which moves down 44px while this shows), in the same style.
    if root.drain-line != "" && !root.map-open && !root.map-modal: drain := FrameFace {
        width: self.content-x + drain-label.preferred-width + Styles.frame.box.padding.right
            + GraphicalSets.inset(Styles.frame.graphics).right;
        height: self.content-y + drain-label.preferred-height + Styles.frame.box.padding.bottom
            + GraphicalSets.inset(Styles.frame.graphics).bottom;
        x: (root.width - self.width) / 2;
        y: root.status-top;

        drain-label := LabelFace {
            x: drain.content-x;
            y: drain.content-y;
            text: root.drain-line;
        }
    }

    if root.game-status != "" && !root.map-open && !root.map-modal: status := FrameFace {
        width: self.content-x + status-label.preferred-width + Styles.frame.box.padding.right
            + GraphicalSets.inset(Styles.frame.graphics).right;
        height: self.content-y + status-label.preferred-height + Styles.frame.box.padding.bottom
            + GraphicalSets.inset(Styles.frame.graphics).bottom;
        x: (root.width - self.width) / 2;
        y: root.status-top + (root.drain-line != "" ? 44px : 0px);

        status-label := LabelFace {
            x: status.content-x;
            y: status.content-y;
            text: root.game-status;
        }
    }

    // The chat box (chat.slint), bottom left above the minimap, while the
    // client has it open (`chat-open`). Always instantiated, so the client
    // can hand its field the keyboard (`chat-take-focus`) the moment it opens.
    in property <bool> chat-open;
    in property <[ChatRow]> chat-lines;
    in-out property <string> chat-draft;
    callback chat-accepted(string);
    public function chat-take-focus() {
        chat.take-focus();
    }
    public function chat-drop-focus() {
        chat.drop-focus();
    }
    chat := ChatBox {
        visible: root.chat-open;
        x: ChatConfig.left;
        y: root.height - self.height - ChatConfig.bottom;
        width: min(root.width * 0.4, ChatConfig.max-width);
        height: min(ChatConfig.box-height, root.height - ChatConfig.bottom - ChatConfig.left);
        lines: root.chat-lines;
        draft <=> root.chat-draft;
        accepted(text) => { root.chat-accepted(text); }
    }

    // `visible` rather than `if`, so its hit-test positions stay readable.
    inventory := InventoryScreen {
        visible: root.inventory-open;
        width: 100%;
        height: 100%;
        hotbar-slots: root.inventory-hotbar;
        main-slots: root.inventory-main;
        container-slots: root.inventory-container;
        cursor-slot: root.inventory-cursor;
        selected: root.inventory-selected;
        pointer-x: root.inventory-pointer-x;
        pointer-y: root.inventory-pointer-y;
        slot-pressed(c, i, r) => { root.inventory-slot-pressed(c, i, r); }
    }

    // Centred where it was opened, and large enough to cover the window
    // from there, so the pointer aims anywhere on screen.
    wheel := RadialMenu {
        property <length> side: 2 * (root.width + root.height);
        visible: root.wheel-open;
        width: self.side;
        height: self.side;
        x: root.wheel-x - self.side / 2;
        y: root.wheel-y - self.side / 2;
        items: root.wheel-items;
        toggled: root.active-tool;
    }

    // The stub windows: `visible` rather than `if`, so their Close probes
    // stay readable.
    settings := StubWindow {
        visible: root.settings-open;
        width: 100%;
        height: 100%;
        title: "Settings";
        close => { root.close-window(); }
    }
    encyclopedia := StubWindow {
        visible: root.encyclopedia-open;
        width: 100%;
        height: 100%;
        title: "Encyclopedia";
        close => { root.close-window(); }
    }

    // `visible` rather than `if`, so its hit-test positions stay readable.
    menu := GameMenu {
        visible: root.menu-open;
        width: 100%;
        height: 100%;
        can-leave: root.can-leave;
        leave-only: root.map-modal;
        open-map => { root.open-map(); }
        close-menu => { root.close-menu(); }
        main-menu => { root.main-menu(); }
        can-retire: root.can-retire;
        retire => { root.retire(); }
        can-end-adventure: root.can-end-adventure;
        end-adventure => { root.end-adventure(); }
    }

    // Over everything else. `visible` rather than `if`, so its hit-test
    // positions above stay readable.
    map := WorldMap {
        visible: root.map-open;
        width: 100%;
        height: 100%;
        map-image: root.map-image;
        layer-names: root.map-layer-names;
        map-layer <=> root.map-layer;
        map-cols: root.map-cols;
        map-rows: root.map-rows;
        map-available: root.map-available;
        home-col: root.home-col;
        home-row: root.home-row;
        selected-col <=> root.selected-col;
        selected-row <=> root.selected-row;
        tile-lines: root.tile-lines;
        play-enabled: root.play-enabled;
        play-reason: root.play-reason;
        map-status: root.map-status;
        sites: root.map-sites;
        show-play: root.show-play;
        hover-blocked: root.hover-blocked;
        reserve-left: root.embark-visible ? root.embark-width + WorldMapConfig.gap : 0px;
        map-zoom <=> root.map-zoom;
        map-pan-x <=> root.map-pan-x;
        map-pan-y <=> root.map-pan-y;
        map-modal: root.map-modal;
        select-tile(col, row) => { root.select-tile(col, row); }
        play => { root.play(); }
        close-map => { root.close-map(); }
    }

    // The Legends tab widens the panel; the map keeps the rest.
    property <length> embark-width: root.embark-tab == 2 ? LegendsLayout.width : EmbarkLayout.width;
    // `visible` rather than `if`, so its hit-test positions above stay
    // readable.
    embark := EmbarkPanel {
        visible: root.map-open && root.embark-visible;
        x: WorldMapConfig.margin;
        y: WorldMapConfig.margin;
        width: root.embark-width;
        height: root.height - 2 * WorldMapConfig.margin;
        civs: root.embark-civs;
        civ-picked: root.embark-civ-picked;
        rows: root.embark-rows;
        counter: root.embark-counter;
        region-text: root.embark-region;
        embark-enabled: root.embark-enabled;
        returns: root.embark-returns;
        pick-civ(i) => { root.embark-pick-civ(i); }
        toggle-person(s, p) => { root.embark-toggle-person(s, p); }
        embark => { root.embark-go(); }
        return-to(i) => { root.embark-return-to(i); }
        tab <=> root.embark-tab;
        tab-changed(i) => { root.embark-tab-changed(i); }
        adventure-civs: root.adventure-civs;
        adventure-civ-picked: root.adventure-civ-picked;
        adventure-sites: root.adventure-sites;
        adventure-site-picked: root.adventure-site-picked;
        adventure-region: root.adventure-region;
        adventure-enabled: root.adventure-enabled;
        adventure-pick-civ(i) => { root.adventure-pick-civ(i); }
        adventure-pick-site(i) => { root.adventure-pick-site(i); }
        adventure-start => { root.adventure-start(); }
        legends-filters: root.legends-filters;
        legends-filter-picked: root.legends-filter-picked;
        legends-header: root.legends-header;
        legends-lines: root.legends-lines;
        legends-more: root.legends-more;
        legends-pick-filter(i) => { root.legends-pick-filter(i); }
        legends-load-more => { root.legends-load-more(); }
        legends-line-clicked(i) => { root.legends-line-clicked(i); }
    }
}
