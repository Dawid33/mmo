import { Button, FrameFace, GraphicalSets, LabelFace, Styles, TextField, VerticalFlow } from "@widgets";

// The main menu: New world / Load world / Prefab editor / Exit, and the reason the last
// session ended (if it did not end by the player's choice), over a saved
// world's map preview (`background-image`; empty = the plain backdrop).
// `join-only` (the browser build, which cannot make or keep worlds) swaps the
// buttons for a server address and Join server. `online-available` (a login
// service is configured) adds Play online to either menu.
export component MainMenu {
    in property <image> background-image;
    in property <string> title: "Orion";
    in property <bool> can-load;
    in property <string> menu-error;
    in property <bool> join-only;
    in property <bool> online-available;
    // Native builds: the prefab editor (its library is files on disk).
    in property <bool> prefabs-available;
    in-out property <string> server-address;
    callback new-world();
    callback load-world();
    callback exit();
    callback join-server(string);
    callback play-online();
    callback prefab-editor();

    // Play online sits between Load world and Exit, as tall as both — on the
    // join-only menu right under Join server (an `if`, so it takes no room
    // when hidden — and has no id to measure).
    out property <length> play-online-button-x: root.join-only ? root.join-button-x : root.load-button-x;
    out property <length> play-online-button-y: root.join-only
        ? join-btn.absolute-position.y + join-btn.height * 1.5 + join.style.spacing
        : (root.load-button-y + root.exit-button-y) / 2;

    out property <length> join-button-x: join-btn.absolute-position.x + join-btn.width / 2;
    out property <length> join-button-y: join-btn.absolute-position.y + join-btn.height / 2;

    out property <length> new-button-x: new-btn.absolute-position.x + new-btn.width / 2;
    out property <length> new-button-y: new-btn.absolute-position.y + new-btn.height / 2;
    out property <length> load-button-x: load-btn.absolute-position.x + load-btn.width / 2;
    out property <length> load-button-y: load-btn.absolute-position.y + load-btn.height / 2;
    out property <length> exit-button-x: exit-btn.absolute-position.x + exit-btn.width / 2;
    out property <length> exit-button-y: exit-btn.absolute-position.y + exit-btn.height / 2;

    Image {
        width: root.width;
        height: root.height;
        source: root.background-image;
        image-fit: cover;
    }
    // Darkens the map so the menu frame stands out.
    Rectangle {
        width: root.width;
        height: root.height;
        background: root.background-image.width > 0 ? #000000a0 : transparent;
    }

    menu := FrameFace {
        title: root.title;
        width: max(root.join-only ? 360px : 260px,
            self.content-x + (root.join-only ? join.preferred-width : body.preferred-width)
            + Styles.frame.box.padding.right + GraphicalSets.inset(Styles.frame.graphics).right);
        height: self.content-y + (root.join-only ? join.preferred-height : body.preferred-height)
            + Styles.frame.box.padding.bottom + GraphicalSets.inset(Styles.frame.graphics).bottom;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        body := VerticalFlow {
            visible: !root.join-only;
            x: menu.content-x;
            y: menu.content-y;
            width: menu.content-right - menu.content-x;

            new-btn := Button {
                text: "New world";
                clicked => { root.new-world(); }
            }
            load-btn := Button {
                text: "Load world";
                enabled: root.can-load;
                clicked => { root.load-world(); }
            }
            if root.online-available && !root.join-only: Button {
                text: "Play online";
                clicked => { root.play-online(); }
            }
            if root.prefabs-available && !root.join-only: Button {
                text: "Prefab editor";
                clicked => { root.prefab-editor(); }
            }
            exit-btn := Button {
                text: "Exit";
                clicked => { root.exit(); }
            }
            if root.menu-error != "": LabelFace {
                text: root.menu-error;
            }
        }

        join := VerticalFlow {
            visible: root.join-only;
            x: menu.content-x;
            y: menu.content-y;
            width: menu.content-right - menu.content-x;

            LabelFace {
                text: "Server";
            }
            TextField {
                text <=> root.server-address;
                accepted => { root.join-server(root.server-address); }
            }
            join-btn := Button {
                text: "Join server";
                enabled: root.server-address != "";
                clicked => { root.join-server(root.server-address); }
            }
            if root.online-available && root.join-only: Button {
                text: "Play online";
                clicked => { root.play-online(); }
            }
            if root.join-only && root.menu-error != "": LabelFace {
                text: root.menu-error;
            }
        }
    }
}
