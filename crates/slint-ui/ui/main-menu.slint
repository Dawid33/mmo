import { Button, FrameFace, GraphicalSets, LabelFace, Styles, VerticalFlow } from "@widgets";

// The shared native/web front door. Page 0 is the product menu; page 1 is the
// single-player submenu. Platform capabilities only disable or omit actions.
export component MainMenu {
    in property <image> background-image;
    in property <string> title: "Errantry";
    in property <int> menu-page;
    in property <bool> single-player-available;
    in property <bool> can-exit;
    in property <bool> can-load;
    in property <string> menu-error;

    callback single-player();
    callback multiplayer();
    callback settings();
    callback exit();
    callback new-world();
    callback load-world();
    callback back();

    out property <length> single-player-button-x: single-player-btn.absolute-position.x + single-player-btn.width / 2;
    out property <length> single-player-button-y: single-player-btn.absolute-position.y + single-player-btn.height / 2;
    out property <length> multiplayer-button-x: multiplayer-btn.absolute-position.x + multiplayer-btn.width / 2;
    out property <length> multiplayer-button-y: multiplayer-btn.absolute-position.y + multiplayer-btn.height / 2;
    out property <length> settings-button-x: settings-btn.absolute-position.x + settings-btn.width / 2;
    out property <length> settings-button-y: settings-btn.absolute-position.y + settings-btn.height / 2;
    out property <length> exit-button-x: exit-btn.absolute-position.x + exit-btn.width / 2;
    out property <length> exit-button-y: exit-btn.absolute-position.y + exit-btn.height / 2;
    out property <length> new-button-x: new-btn.absolute-position.x + new-btn.width / 2;
    out property <length> new-button-y: new-btn.absolute-position.y + new-btn.height / 2;
    out property <length> load-button-x: load-btn.absolute-position.x + load-btn.width / 2;
    out property <length> load-button-y: load-btn.absolute-position.y + load-btn.height / 2;
    out property <length> back-button-x: back-btn.absolute-position.x + back-btn.width / 2;
    out property <length> back-button-y: back-btn.absolute-position.y + back-btn.height / 2;

    Image {
        width: root.width;
        height: root.height;
        source: root.background-image;
        image-fit: cover;
    }
    Rectangle {
        width: root.width;
        height: root.height;
        background: root.background-image.width > 0 ? #000000a0 : transparent;
    }

    menu := FrameFace {
        title: root.menu-page == 1 ? "Single player" : root.title;
        width: 300px;
        height: self.content-y + max(root-page.preferred-height, single-page.preferred-height)
            + Styles.frame.box.padding.bottom + GraphicalSets.inset(Styles.frame.graphics).bottom;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        root-page := VerticalFlow {
            visible: root.menu-page == 0;
            x: menu.content-x;
            y: menu.content-y;
            width: menu.content-right - menu.content-x;

            single-player-btn := Button {
                text: "Single player";
                enabled: root.single-player-available;
                clicked => { root.single-player(); }
            }
            multiplayer-btn := Button {
                text: "Multiplayer";
                clicked => { root.multiplayer(); }
            }
            settings-btn := Button {
                text: "Settings";
                clicked => { root.settings(); }
            }
            exit-slot := Rectangle {
                height: root.can-exit ? exit-btn.preferred-height : 0px;
                exit-btn := Button {
                    width: 100%;
                    height: self.preferred-height;
                    visible: root.can-exit;
                    text: "Exit";
                    clicked => { root.exit(); }
                }
            }
            if root.menu-error != "": LabelFace {
                text: root.menu-error;
            }
        }

        single-page := VerticalFlow {
            visible: root.menu-page == 1;
            x: menu.content-x;
            y: menu.content-y;
            width: menu.content-right - menu.content-x;

            new-btn := Button {
                text: "New world";
                clicked => { root.new-world(); }
            }
            load-btn := Button {
                text: "Load world";
                enabled: root.can-load;
                clicked => { root.load-world(); }
            }
            back-btn := Button {
                text: "Back";
                style: Styles.back-button;
                clicked => { root.back(); }
            }
        }
    }
}
