import { Button, FrameFace, GraphicalSets, LabelFace, Styles, TextField, VerticalFlow } from "@widgets";

// The main menu: New world / Load world / Settings / Exit, and the reason the last
// session ended (if it did not end by the player's choice), over a saved
// world's map preview (`background-image`; empty = the plain backdrop).
// `join-only` replaces local-world actions in the browser. Debug builds can
// also join a typed server address; release builds use Play online when the
// login service is configured.
export component MainMenu {
    in property <image> background-image;
    in property <string> title: "Errantry";
    in property <bool> can-load;
    in property <string> menu-error;
    in property <bool> join-only;
    in property <bool> debug-direct-join;
    in property <bool> online-available;
    in-out property <string> server-address;
    callback new-world();
    callback load-world();
    callback exit();
    callback join-server(string);
    callback play-online();
    // The settings window (settings.slint, shown by `FrontendUi`).
    callback open-settings();

    property <bool> show-direct-join: root.join-only
        && (root.debug-direct-join || !root.online-available);
    property <bool> show-online-only: root.join-only && !root.show-direct-join;

    // Play online sits between its surrounding menu actions.
    out property <length> play-online-button-x: root.show-online-only ? online-play-btn.absolute-position.x + online-play-btn.width / 2
        : root.show-direct-join ? root.join-button-x : root.load-button-x;
    out property <length> play-online-button-y: root.show-online-only ? online-play-btn.absolute-position.y + online-play-btn.height / 2
        : root.show-direct-join
        ? join-btn.absolute-position.y + join-btn.height * 1.5 + join.style.spacing
        : (root.settings-button-y + root.exit-button-y) / 2;

    out property <length> join-button-x: join-btn.absolute-position.x + join-btn.width / 2;
    out property <length> join-button-y: join-btn.absolute-position.y + join-btn.height / 2;

    out property <length> new-button-x: new-btn.absolute-position.x + new-btn.width / 2;
    out property <length> new-button-y: new-btn.absolute-position.y + new-btn.height / 2;
    out property <length> load-button-x: load-btn.absolute-position.x + load-btn.width / 2;
    out property <length> load-button-y: load-btn.absolute-position.y + load-btn.height / 2;
    out property <length> settings-button-x: root.show-online-only
        ? online-settings-btn.absolute-position.x + online-settings-btn.width / 2
        : root.show-direct-join ? join-settings-btn.absolute-position.x + join-settings-btn.width / 2
        : settings-btn.absolute-position.x + settings-btn.width / 2;
    out property <length> settings-button-y: root.show-online-only
        ? online-settings-btn.absolute-position.y + online-settings-btn.height / 2
        : root.show-direct-join ? join-settings-btn.absolute-position.y + join-settings-btn.height / 2
        : settings-btn.absolute-position.y + settings-btn.height / 2;
    out property <length> exit-button-x: exit-btn.absolute-position.x + exit-btn.width / 2;
    out property <length> exit-button-y: exit-btn.absolute-position.y + exit-btn.height / 2;

    Image {
        width: root.width;
        height: root.height;
        source: root.background-image;
        image-fit: cover;
    }
    // Darkens the map so the menu frame stands out.
    Rectangle {
        width: root.width;
        height: root.height;
        background: root.background-image.width > 0 ? #000000a0 : transparent;
    }

    menu := FrameFace {
        title: root.title;
        width: max(root.join-only ? 360px : 260px,
            self.content-x + (root.show-direct-join ? join.preferred-width
                : root.show-online-only ? online.preferred-width : body.preferred-width)
            + Styles.frame.box.padding.right + GraphicalSets.inset(Styles.frame.graphics).right);
        height: self.content-y + (root.show-direct-join ? join.preferred-height
                : root.show-online-only ? online.preferred-height : body.preferred-height)
            + Styles.frame.box.padding.bottom + GraphicalSets.inset(Styles.frame.graphics).bottom;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        body := VerticalFlow {
            visible: !root.join-only;
            x: menu.content-x;
            y: menu.content-y;
            width: menu.content-right - menu.content-x;

            new-btn := Button {
                text: "New world";
                clicked => { root.new-world(); }
            }
            load-btn := Button {
                text: "Load world";
                enabled: root.can-load;
                clicked => { root.load-world(); }
            }
            settings-btn := Button {
                text: "Settings";
                clicked => { root.open-settings(); }
            }
            if root.online-available && !root.join-only: Button {
                text: "Play online";
                clicked => { root.play-online(); }
            }
            exit-btn := Button {
                text: "Exit";
                clicked => { root.exit(); }
            }
            if root.menu-error != "": LabelFace {
                text: root.menu-error;
            }
        }

        join := VerticalFlow {
            visible: root.show-direct-join;
            x: menu.content-x;
            y: menu.content-y;
            width: menu.content-right - menu.content-x;

            LabelFace {
                text: "Server";
            }
            TextField {
                text <=> root.server-address;
                accepted => { root.join-server(root.server-address); }
            }
            join-btn := Button {
                text: "Join server";
                enabled: root.server-address != "";
                clicked => { root.join-server(root.server-address); }
            }
            if root.online-available && root.join-only: Button {
                text: "Play online";
                clicked => { root.play-online(); }
            }
            join-settings-btn := Button {
                text: "Settings";
                clicked => { root.open-settings(); }
            }
            if root.join-only && root.menu-error != "": LabelFace {
                text: root.menu-error;
            }
        }

        online := VerticalFlow {
            visible: root.show-online-only;
            x: menu.content-x;
            y: menu.content-y;
            width: menu.content-right - menu.content-x;

            online-play-btn := Button {
                text: "Play online";
                clicked => { root.play-online(); }
            }
            online-settings-btn := Button {
                text: "Settings";
                clicked => { root.open-settings(); }
            }
            if root.menu-error != "": LabelFace {
                text: root.menu-error;
            }
        }
    }
}
