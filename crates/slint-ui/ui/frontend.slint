import { MainMenu } from "main-menu.slint";
import { KnobRow, MapGenerator } from "map-generator.slint";
import { LoadWorld, WorldRow } from "load-world.slint";
import { Starting } from "starting.slint";
import { Loading } from "loading.slint";
import { LoginScreen } from "login.slint";
import { OnlineWorldRow, ServerBrowser } from "worlds.slint";
import { AccountSettings } from "account-settings.slint";
import { GameTheme } from "theme.slint";
import { SettingsWindow } from "settings.slint";

export { KnobRow, OnlineWorldRow, WorldRow }

// Every screen outside the world: the main menu, the map generator, the world
// list, the starting screen, the loading screen and the online screens
// (login, the online world list). Drawn at FRONTEND_LAYER_ORDER over the
// frontend camera's plain backdrop; `shown: false` draws nothing at all.
export component FrontendUi inherits Window {
    init => {
        GameTheme.apply();
    }
    background: transparent;

    // 0 menu, 1 generator, 2 load, 3 starting, 4 loading (over the world),
    // 5 login, 6 the online world list, 7 account settings.
    in property <int> screen;
    in property <bool> shown: true;
    in property <string> game-title: "Errantry";
    in property <bool> can-load;
    in property <string> menu-error;
    in property <int> menu-page;
    in property <bool> single-player-available;
    in property <bool> can-exit;
    // The main menu's backdrop: a saved world's map preview (empty = none).
    in property <image> menu-background;
    // The starting screen (screen 3, starting.slint), forwarded with a
    // `start-` prefix; its Back is `back` below.
    in property <[string]> start-lines <=> starting.lines;
    in property <string> start-error <=> starting.error;
    in property <string> start-log <=> starting.log;
    // The loading screen (screen 4, loading.slint), with a `load-screen-` prefix.
    in property <float> load-screen-progress <=> loading.progress;
    in property <string> load-screen-step <=> loading.step;
    in property <float> load-screen-fade <=> loading.fade;

    // The settings window (settings.slint) over the main menu: its Settings
    // opens it, its Close shuts it; the client fills it, with a `settings-`
    // prefix (graphics_settings.rs).
    in-out property <bool> settings-open;
    in-out property <float> settings-view-distance <=> settings.view-distance;
    in property <float> settings-view-distance-min <=> settings.view-distance-min;
    in property <float> settings-view-distance-max <=> settings.view-distance-max;
    in property <float> settings-view-distance-step <=> settings.view-distance-step;
    callback settings-view-distance-edited <=> settings.view-distance-edited;
    in-out property <float> settings-detail-distance <=> settings.detail-distance;
    in property <float> settings-detail-distance-min <=> settings.detail-distance-min;
    in property <float> settings-detail-distance-max <=> settings.detail-distance-max;
    in property <float> settings-detail-distance-step <=> settings.detail-distance-step;
    callback settings-detail-distance-edited <=> settings.detail-distance-edited;
    in-out property <bool> settings-vsync <=> settings.vsync;
    callback settings-vsync-edited <=> settings.vsync-edited;
    in-out property <float> settings-fov <=> settings.fov;
    in property <float> settings-fov-min <=> settings.fov-min;
    in property <float> settings-fov-max <=> settings.fov-max;
    in property <float> settings-fov-step <=> settings.fov-step;
    callback settings-fov-edited <=> settings.fov-edited;
    in-out property <bool> settings-view-bobbing <=> settings.view-bobbing;
    callback settings-view-bobbing-edited <=> settings.view-bobbing-edited;
    in-out property <bool> settings-sprint-fov <=> settings.sprint-fov;
    callback settings-sprint-fov-edited <=> settings.sprint-fov-edited;
    in-out property <float> settings-ui-scale <=> settings.ui-scale;
    in property <float> settings-ui-scale-min <=> settings.ui-scale-min;
    in property <float> settings-ui-scale-max <=> settings.ui-scale-max;
    in property <float> settings-ui-scale-step <=> settings.ui-scale-step;
    callback settings-ui-scale-edited <=> settings.ui-scale-edited;
    out property <length> settings-button-x: menu.settings-button-x;
    out property <length> settings-button-y: menu.settings-button-y;
    out property <length> settings-close-x: settings.close-x;
    out property <length> settings-close-y: settings.close-y;

    callback single-player();
    callback multiplayer();
    callback settings();
    callback new-world();
    callback load-world();
    callback exit();
    callback back();

    // The login screen (screen 5, login.slint) and the online world list
    // (screen 6, worlds.slint); their Back is `back` above. `login-error`
    // and `login-busy` are shared by both.
    // The device sign-in: the code to type, the page with it filled in, and
    // whether the game waits for the player to finish at the provider.
    in property <string> login-user-code <=> login.user-code;
    in property <string> login-verify-url <=> login.verify-url;
    in property <bool> login-waiting <=> login.waiting;
    in property <string> login-error;
    in property <bool> login-busy;
    // The world list's status line ("" = none; under `login-error`, which wins),
    // e.g. while a join waits for its world to start.
    in property <string> login-status;
    // The signed-in account's display name (its email when the name is unknown).
    in property <string> login-account;
    in property <[OnlineWorldRow]> worlds;
    in property <[string]> world-names;
    in property <[string]> world-regions;
    in-out property <int> world-region;
    in-out property <string> world-search;
    in-out property <int> world-selected;
    in property <string> world-region-name;
    callback login-sign-in();
    callback login-open-browser();
    callback login-cancel();
    callback world-join(string);
    callback world-refresh();
    callback world-region-chosen(int);
    callback world-select(int);
    callback world-search-edited(string);
    callback settings-log-in();
    callback settings-log-out();
    out property <length> login-sign-in-x: login.sign-in-x;
    out property <length> login-sign-in-y: login.sign-in-y;
    out property <length> login-open-browser-x: login.open-browser-x;
    out property <length> login-open-browser-y: login.open-browser-y;
    out property <length> login-cancel-x: login.cancel-x;
    out property <length> login-cancel-y: login.cancel-y;
    out property <length> worlds-row-x: browser.row-x;
    out property <length> worlds-row0-y: browser.row0-y;
    out property <length> worlds-row-pitch: browser.row-pitch;
    out property <length> worlds-join-x: browser.join-x;
    out property <length> worlds-join-y: browser.join-y;
    out property <length> worlds-refresh-x: browser.refresh-x;
    out property <length> worlds-refresh-y: browser.refresh-y;
    out property <length> settings-log-in-x: account-settings.log-in-x;
    out property <length> settings-log-in-y: account-settings.log-in-y;
    out property <length> settings-log-out-x: account-settings.log-out-x;
    out property <length> settings-log-out-y: account-settings.log-out-y;

    out property <length> new-button-x: menu.new-button-x;
    out property <length> new-button-y: menu.new-button-y;
    out property <length> load-button-x: menu.load-button-x;
    out property <length> load-button-y: menu.load-button-y;
    out property <length> exit-button-x: menu.exit-button-x;
    out property <length> exit-button-y: menu.exit-button-y;
    // The shown screen's Back.
    out property <length> back-button-x: root.screen == 1 ? generator.back-x : root.screen == 2 ? loader.back-x
        : root.screen == 5 ? login.back-x : root.screen == 6 ? browser.back-x
        : root.screen == 7 ? account-settings.back-x
        : root.screen == 0 && root.menu-page == 1 ? menu.back-button-x : starting.back-x;
    out property <length> back-button-y: root.screen == 1 ? generator.back-y : root.screen == 2 ? loader.back-y
        : root.screen == 5 ? login.back-y : root.screen == 6 ? browser.back-y
        : root.screen == 7 ? account-settings.back-y
        : root.screen == 0 && root.menu-page == 1 ? menu.back-button-y : starting.back-y;

    // The world list (screen 2, load-world.slint), forwarded with a `load-`
    // prefix; its Back is `back` above.
    in property <[WorldRow]> load-worlds <=> loader.worlds;
    in-out property <int> load-selected <=> loader.selected;
    in property <image> load-big-preview <=> loader.big-preview;
    in property <[string]> load-settings-lines <=> loader.settings-lines;
    in-out property <bool> load-confirm-delete <=> loader.confirm-delete;
    callback load-select <=> loader.select;
    callback load-load <=> loader.load;
    callback load-delete <=> loader.delete;
    callback load-confirm-delete-yes <=> loader.confirm-delete-yes;
    callback load-confirm-delete-no <=> loader.confirm-delete-no;
    out property <length> load-row-x: loader.row-x;
    out property <length> load-row0-y: loader.row0-y;
    out property <length> load-row-pitch: loader.row-pitch;
    out property <length> load-load-x: loader.load-x;
    out property <length> load-load-y: loader.load-y;
    out property <length> load-delete-x: loader.delete-x;
    out property <length> load-delete-y: loader.delete-y;
    out property <length> load-yes-x: loader.yes-x;
    out property <length> load-yes-y: loader.yes-y;
    out property <length> load-no-x: loader.no-x;
    out property <length> load-no-y: loader.no-y;

    // The map generator (screen 1, map-generator.slint), forwarded with a
    // `gen-` prefix; its Back is `back` above.
    in property <[string]> gen-presets <=> generator.presets;
    in-out property <int> gen-preset <=> generator.preset;
    in property <string> gen-preset-description <=> generator.preset-description;
    in-out property <string> gen-seed-text <=> generator.seed-text;
    in property <bool> gen-seed-invalid <=> generator.seed-invalid;
    in-out property <string> gen-name-text <=> generator.name-text;
    in property <[string]> gen-tabs <=> generator.tabs;
    in-out property <int> gen-tab <=> generator.tab;
    in property <[KnobRow]> gen-rows <=> generator.rows;
    in property <image> gen-preview <=> generator.preview;
    in property <bool> gen-preview-busy <=> generator.preview-busy;
    in property <[string]> gen-stats-lines <=> generator.stats-lines;
    in property <[string]> gen-layers <=> generator.layers;
    in-out property <int> gen-layer <=> generator.layer;
    in-out property <bool> gen-auto-refresh <=> generator.auto-refresh;
    in property <bool> gen-forging <=> generator.forging;
    in property <float> gen-forge-progress <=> generator.forge-progress;
    in property <string> gen-forge-label <=> generator.forge-label;
    in property <string> gen-play-error <=> generator.play-error;
    in property <string> gen-play-estimate <=> generator.play-estimate;
    callback gen-preset-chosen <=> generator.preset-chosen;
    callback gen-seed-edited <=> generator.seed-edited;
    callback gen-shuffle-seed <=> generator.shuffle-seed;
    callback gen-knob-edited <=> generator.knob-edited;
    callback gen-knob-reset <=> generator.knob-reset;
    callback gen-tab-changed <=> generator.tab-changed;
    callback gen-layer-chosen <=> generator.layer-chosen;
    callback gen-refresh <=> generator.refresh;
    callback gen-play <=> generator.play;
    callback gen-cancel-forge <=> generator.cancel-forge;
    out property <length> gen-preset-x: generator.preset-x;
    out property <length> gen-preset-top: generator.preset-top;
    out property <length> gen-preset-height: generator.preset-height;
    out property <length> gen-rows-y: generator.rows-y;
    out property <length> gen-row-height: generator.row-height;
    out property <length> gen-slider-x: generator.slider-x;
    out property <length> gen-slider-width: generator.slider-width;
    out property <length> gen-play-x: generator.play-x;
    out property <length> gen-play-y: generator.play-y;
    out property <length> gen-cancel-x: generator.cancel-x;
    out property <length> gen-cancel-y: generator.cancel-y;

    menu := MainMenu {
        visible: root.shown && root.screen == 0;
        width: root.width;
        height: root.height;
        title: root.game-title;
        can-load: root.can-load;
        menu-error: root.menu-error;
        menu-page: root.menu-page;
        single-player-available: root.single-player-available;
        can-exit: root.can-exit;
        background-image: root.menu-background;
        single-player => { root.single-player(); }
        multiplayer => { root.multiplayer(); }
        settings => { root.settings(); }
        new-world => { root.new-world(); }
        load-world => { root.load-world(); }
        exit => { root.exit(); }
        back => { root.back(); }
    }
    generator := MapGenerator {
        visible: root.shown && root.screen == 1;
        width: root.width;
        height: root.height;
        back => { root.back(); }
    }
    loader := LoadWorld {
        visible: root.shown && root.screen == 2;
        width: root.width;
        height: root.height;
        back => { root.back(); }
    }
    starting := Starting {
        visible: root.shown && root.screen == 3;
        width: root.width;
        height: root.height;
        back => { root.back(); }
    }
    login := LoginScreen {
        visible: root.shown && root.screen == 5;
        width: root.width;
        height: root.height;
        error: root.login-error;
        busy: root.login-busy;
        sign-in => { root.login-sign-in(); }
        open-browser => { root.login-open-browser(); }
        cancel => { root.login-cancel(); }
        back => { root.back(); }
    }
    browser := ServerBrowser {
        visible: root.shown && root.screen == 6;
        width: root.width;
        height: root.height;
        worlds: root.worlds;
        names: root.world-names;
        regions: root.world-regions;
        region <=> root.world-region;
        search <=> root.world-search;
        selected <=> root.world-selected;
        region-name: root.world-region-name;
        account: root.login-account;
        error: root.login-error;
        status: root.login-status;
        busy: root.login-busy;
        region-chosen(i) => { root.world-region-chosen(i); }
        search-edited(text) => { root.world-search-edited(text); }
        select(i) => { root.world-select(i); }
        join(id) => { root.world-join(id); }
        refresh => { root.world-refresh(); }
        back => { root.back(); }
    }
    account-settings := AccountSettings {
        visible: root.shown && root.screen == 7;
        width: root.width;
        height: root.height;
        account: root.login-account;
        busy: root.login-busy;
        error: root.login-error;
        log-in => { root.settings-log-in(); }
        log-out => { root.settings-log-out(); }
        graphics => { root.settings-open = true; }
        back => { root.back(); }
    }
    loading := Loading {
        visible: root.shown && root.screen == 4;
        width: root.width;
        height: root.height;
    }
    // The graphics window is opened from the account Settings screen, and also
    // remains available in the in-world UI through the same component.
    settings := SettingsWindow {
        visible: root.shown && root.screen == 7 && root.settings-open;
        width: root.width;
        height: root.height;
        close => { root.settings-open = false; }
    }
}
