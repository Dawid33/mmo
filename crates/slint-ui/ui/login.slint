// The login screen: Sign in hands the player to the identity
// provider's page in the browser (the OAuth device flow); while the game waits
// for them it shows the code to type, Open browser and Cancel. The client
// (crates/client/src/login/flow.rs) does the talking; this screen only reports
// what the player did. `busy` (a request in flight) disables Sign in; Cancel
// and Back stay usable (they abandon the request).

import { Button, FrameFace, GraphicalSets, LabelFace, Styles } from "@widgets";

export component LoginScreen {
    // The code to type at the provider's page, and the page itself with the
    // code filled in (the browser build opens it from the click).
    in property <string> user-code;
    in property <string> verify-url;
    // The game waits for the player to finish at the provider.
    in property <bool> waiting;
    in property <string> error;
    in property <bool> busy;
    callback sign-in();
    callback open-browser();
    callback cancel();
    callback back();

    property <length> line-height: 28px;
    property <length> code-height: 44px;
    property <length> button-height: 32px;
    property <length> gap: 12px;
    // Rows of the body, from its top (the frame's content-y).
    property <length> status-y: root.waiting
        ? 2 * root.line-height + root.code-height + 2 * root.gap + root.button-height + root.gap
        : root.button-height + root.gap;
    property <length> foot-y: root.status-y + root.line-height;
    property <length> back-top: root.waiting ? root.foot-y + root.gap : root.foot-y + root.line-height + root.gap;

    // Where things are, for the headless tests (absolute, logical px).
    out property <length> sign-in-x: sign-in-btn.absolute-position.x + sign-in-btn.width / 2;
    out property <length> sign-in-y: sign-in-btn.absolute-position.y + sign-in-btn.height / 2;
    out property <length> open-browser-x: open-btn.absolute-position.x + open-btn.width / 2;
    out property <length> open-browser-y: open-btn.absolute-position.y + open-btn.height / 2;
    out property <length> cancel-x: cancel-btn.absolute-position.x + cancel-btn.width / 2;
    out property <length> cancel-y: cancel-btn.absolute-position.y + cancel-btn.height / 2;
    out property <length> back-x: back-btn.absolute-position.x + back-btn.width / 2;
    out property <length> back-y: back-btn.absolute-position.y + back-btn.height / 2;

    frame := FrameFace {
        title: "Log in";
        width: min(root.width - 48px, 480px);
        height: self.content-y + root.back-top + root.button-height
            + Styles.frame.box.padding.bottom + GraphicalSets.inset(Styles.frame.graphics).bottom;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        property <length> inner-width: self.content-right - self.content-x;
        property <length> half-width: (self.inner-width - root.gap) / 2;

        // Idle: one button.
        sign-in-btn := Button {
            visible: !root.waiting;
            x: frame.content-x;
            y: frame.content-y;
            width: frame.inner-width;
            height: root.button-height;
            text: "Sign in";
            style: Styles.confirm-button;
            enabled: !root.busy;
            clicked => { root.sign-in(); }
        }

        // Waiting: the code, and the two ways on.
        LabelFace {
            visible: root.waiting;
            x: frame.content-x;
            y: frame.content-y;
            width: frame.inner-width;
            height: root.line-height;
            text: "Finish signing in in your browser";
        }
        LabelFace {
            visible: root.waiting;
            x: frame.content-x;
            y: frame.content-y + root.line-height;
            width: frame.inner-width;
            height: root.line-height;
            style: Styles.caption-label;
            text: "If asked, enter this code:";
        }
        // Read-only but selectable: the player can copy the code.
        TextInput {
            visible: root.waiting;
            x: frame.content-x;
            y: frame.content-y + 2 * root.line-height + root.gap / 2;
            width: frame.inner-width;
            height: root.code-height;
            text: root.user-code;
            read-only: true;
            single-line: true;
            color: #ffffff;
            font-family: Styles.frame.title.font.family;
            font-weight: Styles.frame.title.font.weight;
            font-size: 28px;
            vertical-alignment: center;
        }
        open-btn := Button {
            visible: root.waiting;
            x: frame.content-x;
            y: frame.content-y + 2 * root.line-height + root.code-height + 2 * root.gap;
            width: frame.half-width;
            height: root.button-height;
            text: "Open browser";
            style: Styles.confirm-button;
            clicked => { root.open-browser(); }
        }
        cancel-btn := Button {
            visible: root.waiting;
            x: frame.content-x + frame.half-width + root.gap;
            y: open-btn.y;
            width: frame.half-width;
            height: root.button-height;
            text: "Cancel";
            clicked => { root.cancel(); }
        }

        // Status line: the error, else "talking to the server".
        LabelFace {
            visible: root.error != "" || root.busy;
            x: frame.content-x;
            y: frame.content-y + root.status-y;
            width: frame.inner-width;
            height: root.line-height;
            style: root.error != "" ? Styles.bold-red-label : Styles.caption-label;
            text: root.error != "" ? root.error : "Talking to the login server\u{2026}";
        }
        LabelFace {
            visible: !root.waiting;
            x: frame.content-x;
            y: frame.content-y + root.foot-y;
            width: frame.inner-width;
            height: root.line-height;
            style: Styles.caption-label;
            text: "New here? You can create an account on the sign-in page.";
        }
        // Back works while busy: it abandons the call in flight.
        back-btn := Button {
            x: frame.content-x;
            y: frame.content-y + root.back-top;
            width: frame.inner-width;
            height: root.button-height;
            style: Styles.back-button;
            text: "Back";
            clicked => { root.back(); }
        }
    }
}
