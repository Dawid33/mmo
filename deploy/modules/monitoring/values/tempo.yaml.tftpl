# Tempo, single binary: traces in S3, OTLP in (Alloy forwards to it).
replicas: 1

tempo:
  reportingEnabled: false
  retention: ${retention}
  metricsGenerator:
    enabled: true
    # Prometheus' remote-write receiver is enabled by kube-prometheus-stack.
    remoteWriteUrl: "http://prometheus-operated.${namespace}.svc:9090/api/v1/write"
    storage:
      path: /var/tempo/metrics
  # No static key: the S3 client's credential chain reads the telemetry-s3 env.
  extraEnvFrom:
    - secretRef:
        name: telemetry-s3
  storage:
    trace:
      backend: s3
      s3:
        bucket: ${bucket}
        # Garage (modules/garage), inside the cluster: host:port, path style.
        endpoint: ${endpoint}
        region: ${region}
        insecure: ${insecure}
        forcepathstyle: true
      wal:
        path: /var/tempo/wal
  # The chart merges in its Jaeger receivers too (its Service template needs them); unused.
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: "0.0.0.0:4317"
        http:
          endpoint: "0.0.0.0:4318"
  resources:
    requests: { cpu: 50m, memory: 256Mi }
    limits: { memory: 1Gi }

persistence:
  enabled: true
  storageClassName: ${storage_class}
  size: ${size}

serviceMonitor:
  enabled: true
