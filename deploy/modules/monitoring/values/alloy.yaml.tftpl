# Grafana Alloy DaemonSet: pod logs -> Loki, OTLP (4317 gRPC / 4318 HTTP) -> Tempo.
# Metrics stay with kube-prometheus-stack (no duplicate kubelet/cAdvisor scrape).
controller:
  type: daemonset

alloy:
  extraEnv:
    # Each instance tails only its own node's pods.
    - name: NODE_NAME
      valueFrom:
        fieldRef:
          fieldPath: spec.nodeName
  extraPorts:
    - name: otlp-grpc
      port: 4317
      targetPort: 4317
      protocol: TCP
    - name: otlp-http
      port: 4318
      targetPort: 4318
      protocol: TCP
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits: { memory: 256Mi }
  configMap:
    content: |
      logging {
        level  = "info"
        format = "logfmt"
      }

      // --- Pod logs (Kubernetes API) -> Loki ---------------------------------
      discovery.kubernetes "pods" {
        role = "pod"
        selectors {
          role  = "pod"
          field = "spec.nodeName=" + sys.env("NODE_NAME")
        }
      }

      discovery.relabel "pods" {
        targets = discovery.kubernetes.pods.targets
        rule {
          source_labels = ["__meta_kubernetes_namespace"]
          target_label  = "namespace"
        }
        rule {
          source_labels = ["__meta_kubernetes_pod_name"]
          target_label  = "pod"
        }
        rule {
          source_labels = ["__meta_kubernetes_pod_container_name"]
          target_label  = "container"
        }
        rule {
          source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_label_app"]
          separator     = ""
          target_label  = "app"
        }
        rule {
          source_labels = ["__meta_kubernetes_pod_node_name"]
          target_label  = "node"
        }
        rule {
          target_label = "cluster"
          replacement  = "${cluster}"
        }
      }

      loki.source.kubernetes "pods" {
        targets    = discovery.relabel.pods.output
        forward_to = [loki.process.pods.receiver]
      }

      // Per-service fixes of what Loki would otherwise guess from the text.
      loki.process "pods" {
        forward_to = [loki.write.default.receiver]

        // Garage writes `<time>  INFO <module>: <message>` in colour, and words
        // every non-2xx reply as `error <status> ...`. Loki finds no level
        // field, falls back to keywords and files those INFO lines under
        // `error` (the rest under `unknown`). So: strip the colour codes, read
        // Garage's own level and send it along as structured metadata, which
        // Loki's detected_level takes over. A 404 "Key not found" reply is a
        // client asking for an object that is not there -- Thanos does it for
        // every block's optional marker files, ~40k times a day -- and goes
        // down to `trace`, the lowest level, instead of being dropped.
        stage.match {
          selector = "{namespace=\"garage\", container=\"garage\"}"

          stage.decolorize {}

          stage.regex {
            expression = "^\\S+\\s+(?P<level>TRACE|DEBUG|INFO|WARN|ERROR)\\s"
          }

          // The braces are escaped for Helm, which templates this file too:
          // Alloy sees {{ "{{ ToLower .Value }}" }}.
          stage.template {
            source   = "level"
            template = "{{ "{{ ToLower .Value }}" }}"
          }

          stage.match {
            selector = "{namespace=\"garage\", container=\"garage\"} |= \"error 404 Not Found, Key not found\""

            stage.template {
              source   = "level"
              template = "trace"
            }
          }

          stage.structured_metadata {
            values = {
              level = "",
            }
          }
        }

        // Tempo (up to v3.1.1 at least) logs its idle poll as a failure: about
        // once a minute the backend worker asks the scheduler for a compaction
        // job, gets `NotFound: no jobs found`, and writes level=error plus a
        // level=warn gRPC line. Upstream main already logs it at debug
        // (`isExpectedSchedulerError` in modules/backendworker); no release has
        // that yet and there is no setting for it. Until one does, file both
        // lines under `debug` here. REMOVE this block after a Tempo bump that
        // stops writing `error calling scheduler ... no jobs found`.
        stage.match {
          selector = "{namespace=\"monitoring\", container=\"tempo\"} |= \"desc = no jobs found\""

          stage.template {
            source   = "level"
            template = "debug"
          }

          stage.structured_metadata {
            values = {
              level = "",
            }
          }
        }
      }

      loki.write "default" {
        endpoint {
          url = "${loki_push_url}"
        }
      }

      // --- OTLP -> Tempo (the in-cluster ingest point for game traces) -------
      otelcol.receiver.otlp "default" {
        grpc {
          endpoint = "0.0.0.0:4317"
        }
        http {
          endpoint = "0.0.0.0:4318"
        }
        output {
          traces = [otelcol.processor.batch.default.input]
        }
      }

      otelcol.processor.batch "default" {
        output {
          traces = [otelcol.exporter.otlp.tempo.input]
        }
      }

      otelcol.exporter.otlp "tempo" {
        client {
          endpoint = "${tempo_otlp_endpoint}"
          tls {
            insecure = true
          }
        }
      }

serviceMonitor:
  enabled: true
