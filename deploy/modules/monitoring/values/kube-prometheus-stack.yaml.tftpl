# kube-prometheus-stack on k3s: Prometheus (+ Thanos sidecar), Alertmanager,
# node-exporter, kube-state-metrics, Grafana.
fullnameOverride: kps

# k3s embeds the controller-manager, scheduler, proxy and etcd in its own
# process: the chart's default endpoints don't exist, so don't scrape (or alert on) them.
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeProxy:
  enabled: false
kubeEtcd:
  enabled: false

alertmanager:
%{ if zulip_alerts ~}
  # Every alert goes to Zulip (its Alertmanager integration: a webhook to a bot's
  # URL, read from the mounted Secret so it never appears in these values).
  # Without this block the chart's default stands: every alert to "null".
  config:
    route:
      receiver: zulip
      group_by: [alertname, cluster]
      routes:
        # Always-firing heartbeats of the stack itself.
        - receiver: "null"
          matchers:
            - alertname =~ "Watchdog|InfoInhibitor"
    receivers:
      - name: "null"
      - name: zulip
        webhook_configs:
          - url_file: /etc/alertmanager/secrets/${zulip_alerts_secret}/url
            send_resolved: true
%{ endif ~}
  alertmanagerSpec:
%{ if zulip_alerts ~}
    secrets: [${zulip_alerts_secret}]
%{ endif ~}
    resources:
      requests: { cpu: 10m, memory: 32Mi }
      limits: { memory: 128Mi }
    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: ${storage_class}
          accessModes: [ReadWriteOnce]
          resources:
            requests:
              storage: ${alertmanager_size}

# Our own alert rules (Prometheus evaluates them, Alertmanager routes them;
# Grafana lists them under Alerting -> Alert rules, data-source-managed).
additionalPrometheusRulesMap:
  node-cpu:
    groups:
      - name: node-cpu
        rules:
          - alert: NodeCpuHigh
            # Whole-node CPU busy share (every core, every non-idle mode).
            expr: |
              100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m]))) > ${cpu_alert_threshold_percent}
            for: ${cpu_alert_for}
            labels:
              severity: warning
              cluster: ${cluster}
            annotations:
              summary: "CPU usage on {{ $labels.instance }} above ${cpu_alert_threshold_percent}%"
              description: "Node {{ $labels.instance }} has averaged {{ printf \"%.1f\" $value }}% CPU over the last 5 minutes (for longer than ${cpu_alert_for})."

  world:
    groups:
      - name: world
        rules:
          - alert: WorldNoCommittedCut
            # Needs a first commit (> 0): the series is 0 until then, see WorldNoFirstCut.
            # `max by (namespace)`: with several coordinator replicas each pod counts only the
            # decisions it wrote, so the newest commit of any replica is the world's.
            expr: |
              max by (namespace) (mmo_cut_last_committed_timestamp_seconds{role="coordinator"}) > 0
              and on (namespace)
              time() - max by (namespace) (mmo_cut_last_committed_timestamp_seconds{role="coordinator"}) > 300
            for: 2m
            labels:
              severity: critical
              cluster: ${cluster}
            annotations:
              summary: "World {{ $labels.namespace }} has committed no cut for 5 minutes"
              description: "The last committed world cut of {{ $labels.namespace }} is {{ $value | humanizeDuration }} old (a save period is 1 minute)."

          - alert: WorldNoFirstCut
            # mmo_hosts_live is set only while the coordinator runs world cuts (several hosts),
            # so a one-host world, which never cuts, does not fire. Only the ticker replica reads the
            # hosts (another's mmo_hosts_live is stale), and any replica may write a cut's decision.
            expr: |
              max by (namespace) (mmo_hosts_live{role="coordinator"} and on (namespace, pod) (mmo_coordinator_is_ticker{role="coordinator"} == 1)) > 0
              and on (namespace)
              max by (namespace) (mmo_cut_last_committed_timestamp_seconds{role="coordinator"}) == 0
            for: 10m
            labels:
              severity: critical
              cluster: ${cluster}
            annotations:
              summary: "World {{ $labels.namespace }} never committed a cut"
              description: "The coordinator of {{ $labels.namespace }} has run world cuts (hosts live) for 10 minutes and has committed none yet."

          - alert: WorldCoordinatorDown
            # Only while the namespace's coordinator Deployment has replicas > 0 (a stopped world is silent).
            expr: |
              (kube_deployment_spec_replicas{namespace=~"world-.*", deployment="coordinator"} > 0)
              unless on (namespace)
              (mmo_registered{role="coordinator"} == 1)
            for: 2m
            labels:
              severity: critical
              cluster: ${cluster}
            annotations:
              summary: "World {{ $labels.namespace }} has no registered coordinator"
              description: "The coordinator Deployment of {{ $labels.namespace }} wants replicas but no coordinator reports itself registered (down, not scraped, or not listening)."

          - alert: WorldCoordinatorReplicasDown
            # Fewer registered coordinator replicas than the Deployment wants (one of two down: the
            # world runs on, without a spare). None registered at all (a forge wait, a stopped
            # world, every replica down) is WorldCoordinatorDown's, not this one's. The spec side
            # aggregated: kube-state-metrics series may be duplicated during its own rollout.
            expr: |
              (sum by (namespace) (mmo_registered{role="coordinator"}) < on (namespace) max by (namespace) (kube_deployment_spec_replicas{namespace=~"world-.*", deployment="coordinator"})) and on (namespace) (sum by (namespace) (mmo_registered{role="coordinator"}) > 0)
            for: 5m
            labels:
              severity: warning
              cluster: ${cluster}
            annotations:
              summary: "World {{ $labels.namespace }} runs fewer coordinator replicas than it wants"
              description: "Only {{ $value }} coordinator replica(s) of {{ $labels.namespace }} have reported themselves registered for 5 minutes, fewer than the Deployment's replicas: a replica pod down, crash-looping, unscheduled (one node after a drain) or not scraped. The world runs on the others."

          - alert: WorldCoordinatorConflicts
            # A conflict = a replica's write of the coordinator row lost its compare-and-set to
            # another replica's: it re-reads the row and replays its inputs. Some are normal.
            expr: |
              rate(mmo_coordinator_conflicts_total{role="coordinator"}[10m]) > 0.5
            for: 15m
            labels:
              severity: warning
              cluster: ${cluster}
            annotations:
              summary: "Coordinator replicas of {{ $labels.namespace }} keep conflicting"
              description: "Pod {{ $labels.pod }} of {{ $labels.namespace }} has lost {{ printf \"%.2f\" $value }} row writes per second to another replica for 15 minutes (each a re-read and a replay). Look at the replicas' `[coordinator] window=` lines (transitions, conflicts, written bytes) before acting; split the coordinator row only after measuring that the conflicts cost what it would save."

          - alert: WorldCoordinatorNoTicker
            # The ticker (the lowest live replica id) alone runs the timed and lease work: cuts
            # started, hosts declared dead, the calendar. Only while a replica is registered (none
            # registered is WorldCoordinatorDown; a world waiting for its forge has no ticker yet).
            expr: |
              max by (namespace) (mmo_coordinator_is_ticker{role="coordinator"}) == 0
              and on (namespace)
              max by (namespace) (mmo_registered{role="coordinator"}) == 1
            for: 2m
            labels:
              severity: critical
              cluster: ${cluster}
            annotations:
              summary: "World {{ $labels.namespace }} has no coordinator ticker"
              description: "No coordinator replica of {{ $labels.namespace }} has called itself the ticker for 2 minutes: no world cuts start, no dead host is declared, the calendar stands. A dead ticker is replaced within a replica lease (10 s); longer means the replicas disagree about who is live — see their logs."

          - alert: WorldSuccessionDeclared
            expr: |
              increase(mmo_successions_declared_total{role="coordinator"}[10m]) > 0
            for: 0m
            labels:
              severity: warning
              cluster: ${cluster}
            annotations:
              summary: "A succession was declared in {{ $labels.namespace }}"
              description: "The coordinator of {{ $labels.namespace }} declared a succession in the last 10 minutes: a host declared dead (a crash), OR the land of a host that left cleanly given to an heir (a Leave succession — after every drain, and after a restart or a stop/start of a host that held land). The coordinator's log line says which."

          - alert: WorldSuccessionStuck
            expr: |
              mmo_successions_open{role="coordinator"} > 0
            for: 2m
            labels:
              severity: critical
              cluster: ${cluster}
            annotations:
              summary: "A succession of {{ $labels.namespace }} is open"
              description: "{{ $value }} succession(s) of {{ $labels.namespace }} have stayed open for 2 minutes (normally settled by the next committed cut)."

          - alert: WorldRollback
            # The inner `> 0` drops the 0 of a coordinator that had not seen a host yet, so the
            # 0 -> N step at start is no rollback; a coordinator restart (back to the same N) is none either.
            # `max by (namespace)` on both sides: a coordinator pod replaced within the 10 minutes has
            # another `pod` label, and a per-pod comparison would find no pair and hide the rollback.
            expr: |
              max by (namespace) (mmo_world_generation{role="coordinator"})
              >
              (max by (namespace) (mmo_world_generation{role="coordinator"} offset 10m) > 0)
            for: 0m
            labels:
              severity: critical
              cluster: ${cluster}
            annotations:
              summary: "World {{ $labels.namespace }} rolled back"
              description: "The world generation of {{ $labels.namespace }} rose in the last 10 minutes: every host restarted from the last cut."

          - alert: WorldHostsBelowReplicas
            # A host that hangs between its registration and its first loop pass stays live and Ready
            # for Kubernetes (/livez judges only from the first pass): the coordinator's count of live
            # hosts is what shows it. One Deployment host-<name> of 1 replica per host: the right side
            # counts the host Deployments that want a pod (made by the fleet reconciler from
            # desired_hosts since Elastic 4). Silent with one host (mmo_hosts_live is set
            # only while world cuts run — never under `static`, but a lone `claim` host sets it: hence
            # the `> 1`, on the count — written in parentheses, since comparisons bind left to right) and while the world is stopped
            # (every host Deployment at 0). A drained host keeps its Deployment at 1 but is no live
            # host: the coordinator removes its desired row once it owns nothing and the reconciler
            # deletes the Deployment, so this fires only when that takes longer than 5 minutes (a last
            # leaver that kept in-flight rows waits for the next host to inherit them; the reconciler
            # down is WorldFleetDown). The ticker replica's count only (it alone reads the hosts;
            # another replica's value is stale).
            expr: |
              max by (namespace) (mmo_hosts_live{role="coordinator"} and on (namespace, pod) (mmo_coordinator_is_ticker{role="coordinator"} == 1))
              < on (namespace)
              (count by (namespace) (kube_deployment_spec_replicas{namespace=~"world-.*", deployment=~"host-.*"} > 0) > 1)
            for: 5m
            labels:
              severity: warning
              cluster: ${cluster}
            annotations:
              summary: "World {{ $labels.namespace }} has fewer live hosts than its host Deployments want"
              description: "The coordinator of {{ $labels.namespace }} has counted {{ $value }} live host(s) for 5 minutes, fewer than its host Deployments that want a pod (a host down, hung or crash-looping at its start, or drained and not removed yet: the coordinator removes a drained host's desired row once it owns nothing and the fleet reconciler deletes its Deployment — nothing to apply; a last leaver holding in-flight rows stays until the next host inherits them; see `just world-status` and WorldFleetDown; one-host worlds never fire)."

          - alert: WorldFleetDown
            # The fleet reconciler (Deployment fleet, VOXEL_ROLE=fleet) is wanted and not Ready. It is
            # unready while the world waits for its forge (/readyz `forge`), while the coordinator is
            # at 0 (`stopped`) and after a pass with a failed read or action (`failing`). world-stop
            # scales it to 0 first, so a stopped world is silent. Nothing running breaks, but no host
            # Deployment is created or deleted meanwhile: no scale-up, no new host below the minimum
            # or for a login at zero hosts, a drained host's pod stays.
            expr: |
              (max by (namespace) (kube_deployment_spec_replicas{namespace=~"world-.*", deployment="fleet"}) > 0)
              unless on (namespace)
              (max by (namespace) (kube_deployment_status_replicas_ready{namespace=~"world-.*", deployment="fleet"}) > 0)
            for: 10m
            labels:
              severity: warning
              cluster: ${cluster}
            annotations:
              summary: "The fleet reconciler of {{ $labels.namespace }} is not Ready"
              description: "The Deployment fleet of {{ $labels.namespace }} wants a pod and none has been Ready for 10 minutes (its /readyz body says why: forge, stopped or failing; `just world-logs fleet`). The running hosts are untouched, but the world adds and removes no host Deployment until it is back."

          - alert: WorldFleetBehind
            # The reconciler's last read showed a different number of desired_hosts rows than host
            # Deployments labelled for the world, or its reads / actions keep failing (each is retried
            # by the next pass, every 2 s). A row is normally matched within a pass or two. A
            # Deployment labelled errantry/fleet=<world> WITHOUT errantry/host (made by hand; the module
            # makes none) is counted but never touched: it keeps this firing until it is deleted.
            expr: |
              (mmo_fleet_desired{role="fleet"} != mmo_fleet_deployments{role="fleet"})
              or
              (rate(mmo_fleet_errors_total{role="fleet"}[5m]) > 0)
            for: 10m
            labels:
              severity: warning
              cluster: ${cluster}
            annotations:
              summary: "The fleet reconciler of {{ $labels.namespace }} does not match desired_hosts"
              description: "For 10 minutes pod {{ $labels.pod }} of {{ $labels.namespace }} has either seen a number of desired hosts different from its host Deployments, or kept failing reads or actions (mmo_fleet_errors_total rising): a template it cannot render, an API call refused (its Role), the database or the API server unreachable. Its log lines `[fleet] …` say which (`just world-logs fleet`); `just world-status` shows the desired rows and the Deployments."

          - alert: WorldFleetSaturated
            # Capacity, for the owner: even the LEAST-loaded registered host of the world has had its
            # worst tick at or above 600 permille of the tick period (mmo_host_load_tick_permille, from
            # its heartbeat) for 15 minutes. 600 is the coordinator's SCALE_UP_LOAD_PERMILLE (a rule file
            # cannot read the const: keep the two equal). Scale-up (rule 5) adds a host after
            # up_after_ms (default 1 minute) when it can, so this holding for 15 minutes means it could
            # not: the fleet is at fleet.max (the coordinator does not ask at the maximum, and no metric
            # says so), no slot is free, the scale gates do not hold (a host draining, a succession
            # open), or the reconciler does not create hosts (WorldFleetDown / WorldFleetBehind).
            # Drained hosts (unregistered) are left out; a world with no host reports nothing.
            expr: |
              min by (namespace) (
                mmo_host_load_tick_permille{role="host"}
                and on (namespace, pod)
                (mmo_registered{role="host"} == 1)
              ) >= 600
            for: 15m
            labels:
              severity: warning
              cluster: ${cluster}
            annotations:
              summary: "Every host of {{ $labels.namespace }} has been busy for 15 minutes"
              description: "The least-loaded host of {{ $labels.namespace }} has reported a worst tick of {{ $value }} permille (>= 600, the coordinator's SCALE_UP_LOAD_PERMILLE) for 15 minutes, while scale-up acts after about a minute: the fleet is at fleet.max, has no free slot, cannot scale (a drain or a succession in progress), or its hosts are not being created. Raise fleet.max in the world root (and open the larger UDP node port range, output client_ports), or see `just world-status` (the coordinator's fleet counters, the reconciler's)."

          - alert: WorldFleetNoFreeSlot
            # The coordinator wanted a host — below the minimum (rule 4), or for a login with no host
            # taking logins anywhere (a world starting) — and the store answered Full: every one of
            # fleet.max slots is held, draining hosts included (a draining host keeps its slot until its
            # row is removed). Scale-up never gets Full: it asks only below the maximum and never while
            # something drains. Expected for the whole notice of a long drain on a min = max world (the
            # ticker asks again every ~10 s); only a run of 20 minutes fires. Summed over the replicas.
            expr: |
              sum by (namespace) (increase(mmo_fleet_full_total{role="coordinator"}[10m])) > 0
            for: 20m
            labels:
              severity: warning
              cluster: ${cluster}
            annotations:
              summary: "World {{ $labels.namespace }} wants a host and has no free slot"
              description: "The coordinator of {{ $labels.namespace }} has kept wanting a host for 20 minutes (below the fleet's minimum, or for a login while no host takes logins) while every slot of fleet.max was held, draining hosts included. Find the draining host that holds a slot (`just world-hosts`: a last leaver keeps its slot until the next host inherits its in-flight rows), or raise fleet.max. Expected during a long drain on a world whose min equals max."

          - alert: WorldHostNotReady
            # A drained host (mmo_waiting{why="drained"}) is unregistered on purpose until it is
            # removed: left out here; WorldHostsBelowReplicas is its cue.
            expr: |
              mmo_registered{role="host"} == 0
              unless on (namespace, pod) (mmo_waiting{role="host", why="drained"} == 1)
            for: 5m
            labels:
              severity: warning
              cluster: ${cluster}
            annotations:
              summary: "A host of {{ $labels.namespace }} is not registered"
              description: "Pod {{ $labels.pod }} of {{ $labels.namespace }} has not registered for 5 minutes (see mmo_waiting for why: forge, or none while it starts). A drained host is not counted here (WorldHostsBelowReplicas)."

          - alert: WorldPodRestartLoop
            expr: |
              increase(kube_pod_container_status_restarts_total{namespace=~"world-.*"}[15m]) > 3
            for: 0m
            labels:
              severity: critical
              cluster: ${cluster}
            annotations:
              summary: "{{ $labels.pod }} restarts repeatedly"
              description: "Container {{ $labels.container }} of {{ $labels.namespace }}/{{ $labels.pod }} restarted more than 3 times in 15 minutes."

          - alert: WorldBackupFailed
            # Only Jobs started in the last day: a failed Job is retained (history limit) after a later
            # success, and must not keep the alert firing; the next nightly run decides again.
            expr: |
              kube_job_status_failed{namespace="postgres", job_name=~"pg-dump.*"} > 0
              and on (namespace, job_name)
              (time() - kube_job_status_start_time{namespace="postgres", job_name=~"pg-dump.*"} < 86400)
            for: 0m
            labels:
              severity: warning
              cluster: ${cluster}
            annotations:
              summary: "A Postgres backup job failed"
              description: "Job {{ $labels.job_name }} in namespace postgres, started in the last day, has failed pods."

prometheusOperator:
  resources:
    requests: { cpu: 20m, memory: 64Mi }
    limits: { memory: 256Mi }

kube-state-metrics:
  resources:
    requests: { cpu: 10m, memory: 64Mi }
    limits: { memory: 256Mi }

prometheus-node-exporter:
  resources:
    requests: { cpu: 10m, memory: 32Mi }
    limits: { memory: 128Mi }

prometheus:
  # Headless gRPC service of the sidecars: Thanos Query discovers them through it.
  thanosService:
    enabled: true
  thanosServiceMonitor:
    enabled: true
  # Scrape targets outside this release.
  additionalPodMonitors:
    # k3s's bundled Traefik (kube-system, HelmChart `traefik`) serves Prometheus
    # metrics on its `metrics` entrypoint (:9100) but ships no Service or monitor
    # for it. Feeds the Traefik dashboard (dashboards/traefik.json).
    - name: traefik
      namespaceSelector:
        matchNames: [kube-system]
      selector:
        matchLabels:
          app.kubernetes.io/name: traefik
      podMetricsEndpoints:
        - port: metrics
          path: /metrics
          interval: 30s
  prometheusSpec:
    retention: ${retention}
    retentionSize: ${retention_size}
    externalLabels:
      cluster: ${cluster}
    # Pick up every ServiceMonitor / PodMonitor / rule / probe in the cluster,
    # not only ones carrying this release's labels (the game's will come later).
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    probeSelectorNilUsesHelmValues: false
    scrapeConfigSelectorNilUsesHelmValues: false
    # The sidecar uploads 2 h blocks: local compaction must stay off.
    disableCompaction: true
    # The sidecar reads the objstore Secret once: a changed store restarts the pod.
    podMetadata:
      annotations:
        checksum/objstore: "${objstore_checksum}"
    thanos:
      image: ${thanos_image}
      objectStorageConfig:
        existingSecret:
          name: thanos-objstore
          key: objstore.yml
    resources:
      requests: { cpu: 200m, memory: 1Gi }
      limits: { memory: 2Gi }
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: ${storage_class}
          accessModes: [ReadWriteOnce]
          resources:
            requests:
              storage: ${prometheus_size}

grafana:
  admin:
    existingSecret: grafana-admin
    userKey: admin-user
    passwordKey: admin-password
  persistence:
    enabled: true
    type: pvc
    storageClassName: ${storage_class}
    size: ${grafana_size}
  # A PVC is ReadWriteOnce: never run two Grafanas at once during a rollout.
  deploymentStrategy:
    type: Recreate
  # 256Mi OOM-killed it on first start (migrations + plugin install); steady state is lower.
  resources:
    requests: { cpu: 20m, memory: 256Mi }
    limits: { memory: 1Gi }
%{ if grafana_oidc ~}
  # The OAuth client secret (Secret from main.tf), kept out of these values.
  envValueFrom:
    GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET:
      secretKeyRef:
        name: ${grafana_oidc_secret}
        key: client-secret
%{ endif ~}
  plugins:
    - grafana-pyroscope-app
  grafana.ini:
    server:
      domain: ${grafana_host}
      root_url: https://${grafana_host}
    auth.anonymous:
      enabled: false
%{ if !grafana_password_login ~}
    # No username / password form: the identity provider's button is the only
    # way in through the browser. Basic auth on the API stays on purpose: the
    # dashboard / datasource sidecars reload Grafana with the admin credentials.
    auth:
      disable_login_form: true
%{ endif ~}
%{ if grafana_oidc ~}
    # Login through the identity provider (Keycloak's staff realm). The role
    # mapping is STRICT: a person without a grafana role
    # there (claim grafana_roles: admin / editor / viewer) is refused, not made
    # a Viewer. The local `admin` login stays as the way in when it is down.
    auth.generic_oauth:
      enabled: true
      name: ${grafana_oidc_name}
      client_id: ${grafana_oidc_client_id}
      scopes: openid email profile
      auth_url: ${grafana_oidc_issuer}/protocol/openid-connect/auth
      token_url: ${grafana_oidc_issuer}/protocol/openid-connect/token
      api_url: ${grafana_oidc_issuer}/protocol/openid-connect/userinfo
      use_pkce: true
      allow_sign_up: true
      login_attribute_path: preferred_username
      name_attribute_path: preferred_username
      email_attribute_path: email
      role_attribute_path: "contains(grafana_roles[*], 'admin') && 'Admin' || contains(grafana_roles[*], 'editor') && 'Editor' || contains(grafana_roles[*], 'viewer') && 'Viewer'"
      role_attribute_strict: true
%{ endif ~}
    analytics:
      reporting_enabled: false
      check_for_updates: false
    # Day first everywhere. Grafana's defaults are ISO for full dates but
    # month-first (MM/DD) on graph axes.
    date_formats:
      full_date: DD/MM/YYYY HH:mm:ss
      interval_hour: DD/MM HH:mm
      interval_day: DD/MM
      interval_month: MM/YYYY
  ingress:
    enabled: true
    ingressClassName: ${ingress_class}
    annotations:
      cert-manager.io/cluster-issuer: ${cluster_issuer}
    hosts:
      - ${grafana_host}
    tls:
      - secretName: grafana-tls
        hosts:
          - ${grafana_host}
  sidecar:
    datasources:
      # The chart's own Prometheus datasource stays (direct, last ${retention}),
      # but Thanos Query is the default.
      isDefaultDatasource: false
      name: Prometheus (local)
  additionalDataSources:
    - name: Thanos
      uid: thanos
      type: prometheus
      url: http://thanos-query.${namespace}.svc:10902
      access: proxy
      isDefault: true
      jsonData:
        prometheusType: Thanos
        timeInterval: 30s
    - name: Loki
      uid: loki
      type: loki
      url: http://loki.${namespace}.svc:3100
      access: proxy
      jsonData:
        derivedFields:
          - name: TraceID
            datasourceUid: tempo
            matcherRegex: '(?:trace_?id|traceID)[=:"]+(\w+)'
            url: '$${__value.raw}'
    - name: Tempo
      uid: tempo
      type: tempo
      url: http://tempo.${namespace}.svc:3200
      access: proxy
      jsonData:
        tracesToLogsV2:
          datasourceUid: loki
          spanStartTimeShift: -5m
          spanEndTimeShift: 5m
          filterByTraceID: true
        tracesToProfiles:
          datasourceUid: pyroscope
          profileTypeId: process_cpu:cpu:nanoseconds:cpu:nanoseconds
        serviceMap:
          datasourceUid: thanos
        nodeGraph:
          enabled: true
        lokiSearch:
          datasourceUid: loki
    - name: Pyroscope
      uid: pyroscope
      type: grafana-pyroscope-datasource
      url: http://pyroscope.${namespace}.svc:4040
      access: proxy
