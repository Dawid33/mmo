# Loki, monolithic (one binary, one replica), chunks + index (TSDB, schema v13) in S3.
deploymentMode: Monolithic

loki:
  auth_enabled: false
  commonConfig:
    replication_factor: 1
  schemaConfig:
    configs:
      - from: "2026-11-01"
        store: tsdb
        object_store: s3
        schema: v13
        index:
          prefix: index_
          period: 24h
  storage:
    type: s3
    bucketNames:
      chunks: ${bucket}
      ruler: ${bucket}
      admin: ${bucket}
    s3:
      region: ${region}
      # No static key: the AWS SDK reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
      # from the telemetry-s3 Secret (extraEnvFrom below).
  limits_config:
    retention_period: ${retention}
    allow_structured_metadata: true
    volume_enabled: true
  compactor:
    retention_enabled: true
    delete_request_store: s3
  pattern_ingester:
    enabled: false
  ruler:
    enable_api: false

singleBinary:
  replicas: 1
  extraEnvFrom:
    - secretRef:
        name: telemetry-s3
  persistence:
    enabled: true
    storageClass: ${storage_class}
    size: ${size}
  resources:
    requests: { cpu: 100m, memory: 512Mi }
    limits: { memory: 1Gi }

# Monolithic: the scalable targets stay at zero.
read:
  replicas: 0
write:
  replicas: 0
backend:
  replicas: 0

gateway:
  enabled: false
chunksCache:
  enabled: false
resultsCache:
  enabled: false
lokiCanary:
  enabled: false
test:
  enabled: false

# Loki's own metrics (no dashboards / rules / self-log collection from the chart).
monitoring:
  serviceMonitor:
    enabled: true
