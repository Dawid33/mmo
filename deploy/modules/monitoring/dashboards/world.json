      },
      {
        "name": "namespace",
        "label": "World",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(mmo_registered, namespace)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(mmo_registered, namespace)",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "allValue": "world-.*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "regex": "",
        "options": []
      },
      {
        "name": "world",
        "label": "World id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(mmo_registered{namespace=~\"$namespace\"}, namespace)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(mmo_registered{namespace=~\"$namespace\"}, namespace)",
        "current": {
          "selected": false,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 2,
        "regex": "/^world-(.*)$/",
        "options": []
      }
    ]
  },
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
