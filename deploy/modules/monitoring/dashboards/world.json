              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Edge 5xx share",
      "description": "Aggregate Traefik HTTP 5xx share. Open Traefik for service/router detail.",
      "datasource": {
