          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (kube_pod_status_ready{cluster=~\"$cluster\",namespace=~\"postgres|pg-management\",pod!~\"pg-dump-.*\",condition=\"true\"}) / clamp_min(count by (namespace) (kube_pod_info{cluster=~\"$cluster\",namespace=~\"postgres|pg-management\",pod!~\"pg-dump-.*\"}), 1)",
          "legendFormat": "pods ready {{namespace}}",
