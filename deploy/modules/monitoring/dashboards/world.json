    {
      "id": 12,
      "type": "timeseries",
      "title": "Database pods and latest backup success",
      "description": "Readiness is workload-level only. The age is the latest successful pg-dump Job completion; exact CNPG engine/query metrics are a gap.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
