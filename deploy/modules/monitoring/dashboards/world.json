    {
      "id": 11,
      "type": "timeseries",
      "title": "Identity and site readiness",
      "description": "Kubernetes workload readiness across login, Keycloak, site, panel and world web. Login end-to-end outcomes are an instrumentation gap.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "((sum by (namespace) (kube_deployment_status_replicas_ready{cluster=~\"$cluster\",namespace=~\"login|keycloak|site|panel\"}) / clamp_min(sum by (namespace) (kube_deployment_spec_replicas{cluster=~\"$cluster\",namespace=~\"login|keycloak|site|panel\"}), 1)) and on (namespace) (sum by (namespace) (kube_deployment_spec_replicas{cluster=~\"$cluster\",namespace=~\"login|keycloak|site|panel\"}) > 0)) or ((sum by (namespace) (kube_deployment_status_replicas_ready{cluster=~\"$cluster\",namespace=~\"$namespace\",deployment=\"web\"}) / clamp_min(sum by (namespace) (kube_deployment_spec_replicas{cluster=~\"$cluster\",namespace=~\"$namespace\",deployment=\"web\"}), 1)) and on (namespace) (sum by (namespace) (kube_deployment_spec_replicas{cluster=~\"$cluster\",namespace=~\"$namespace\",deployment=\"web\"}) > 0))",
          "legendFormat": "Deployment {{namespace}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (kube_statefulset_status_replicas_ready{cluster=~\"$cluster\",namespace=~\"login|keycloak\"}) / clamp_min(sum by (namespace) (kube_statefulset_replicas{cluster=~\"$cluster\",namespace=~\"login|keycloak\"}), 1)",
