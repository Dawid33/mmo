  },
  "description": "Kubernetes workload, backup Job, PVC and Garage backup-bucket health for the pg and pg-management database clusters.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
