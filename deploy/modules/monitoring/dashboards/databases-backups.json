    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Garage S3 detail",
      "type": "link",
      "url": "/d/garage-s3/garage-s3-buckets"
    },
    {
      "asDropdown": false,
      "icon": "bell",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
