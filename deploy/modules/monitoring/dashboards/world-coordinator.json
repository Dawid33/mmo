          },
          "editorMode": "code",
          "expr": "sum by (namespace,route) (rate(mmo_coordinator_api_requests_total{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{namespace}} {{route}}",
          "range": true,
