          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Mailbox detaches per minute",
      "description": "Stalled counters are ticker decisions, while rows and age describe the current queue.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (rate(mmo_coordinator_stalled_total{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"}[5m])) * 60",
          "legendFormat": "detaches/min {{namespace}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace) (mmo_coordinator_mailbox_oldest_ms{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"}) / 1000",
          "legendFormat": "oldest seconds {{namespace}}",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/oldest/"
