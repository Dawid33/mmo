    {
      "id": 11,
      "type": "timeseries",
      "title": "Coordinator API error share",
      "description": "Host-route 5xx above 5% for 10 minutes matches WorldCoordinatorApiErrors. Login-order 503s are excluded because world_starting is an answer.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * sum by (namespace,route) (rate(mmo_coordinator_api_requests_total{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\",route!=\"login_orders\",code=~\"5..\"}[5m])) / clamp_min(sum by (namespace,route) (rate(mmo_coordinator_api_requests_total{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\",route!=\"login_orders\"}[5m])), 0.000001)",
          "legendFormat": "5xx {{namespace}} {{route}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * sum by (namespace,route) (rate(mmo_coordinator_api_requests_total{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\",code=~\"4..\"}[5m])) / clamp_min(sum by (namespace,route) (rate(mmo_coordinator_api_requests_total{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"}[5m])), 0.000001)",
          "legendFormat": "4xx {{namespace}} {{route}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (rate(mmo_coordinator_api_requests_total{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\",route=\"login_orders\",code=\"202\"}[5m])) * 60",
          "legendFormat": "login accepted/min {{namespace}}",
          "range": true,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/login accepted/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
