  "description": "Cross-signal Errantry telemetry: traces, correlated logs and CPU profiles. Select low-cardinality resource labels before investigating.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "traces",
      "title": "Recent traces",
      "description": "Latest traces matching the selected deployment. Select a trace ID to open the same time window in Explore.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "editorMode": "code",
          "limit": 50,
          "query": "{ resource.deployment.environment.name =~ \"$environment\" && resource.k8s.cluster.name =~ \"$cluster\" && resource.service.name =~ \"$service\" && resource.mmo.role =~ \"$role\" && resource.k8s.pod.name =~ \"$pod\" && (resource.mmo.world_id = nil || resource.mmo.world_id =~ \"$world\") }",
          "queryType": "traceqlSearch",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "links": [
            {
              "targetBlank": false,
              "title": "Open trace in Explore",
              "url": "/explore?orgId=1&left=%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22${__value.raw}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D"
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "traces",
      "title": "Error traces",
      "description": "Traces containing a span in error status. Scope is bounded by environment, service, role, world and pod.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "editorMode": "code",
          "limit": 50,
          "query": "{ resource.deployment.environment.name =~ \"$environment\" && resource.k8s.cluster.name =~ \"$cluster\" && resource.service.name =~ \"$service\" && resource.mmo.role =~ \"$role\" && resource.k8s.pod.name =~ \"$pod\" && (resource.mmo.world_id = nil || resource.mmo.world_id =~ \"$world\") && (status = error || (span.outcome != nil && span.outcome =~ \"(?i)(error|failed|transport|status|body|pin|refused|retry|retryable|fenced|conflict)\")) }",
          "queryType": "traceqlSearch",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "targetBlank": false,
              "title": "Open trace in Explore",
              "url": "/explore?orgId=1&left=%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22${__value.raw}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D"
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Operation duration p50",
      "description": "TraceQL metrics query, grouped by fixed span name and role. Tempo metrics must be enabled for this panel to return data.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "editorMode": "code",
          "expr": "",
          "query": "{ resource.deployment.environment.name =~ \"$environment\" && resource.k8s.cluster.name =~ \"$cluster\" && resource.service.name =~ \"$service\" && resource.mmo.role =~ \"$role\" && resource.k8s.pod.name =~ \"$pod\" && (resource.mmo.world_id = nil || resource.mmo.world_id =~ \"$world\") } | quantile_over_time(duration, 0.5) by (name, resource.mmo.role)",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
