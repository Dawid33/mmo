          "query": "{ resource.deployment.environment.name =~ \"$environment\" && resource.k8s.cluster.name =~ \"$cluster\" && resource.service.name =~ \"$service\" && resource.mmo.role =~ \"$role\" && resource.k8s.pod.name =~ \"$pod\" && (resource.mmo.world_id = nil || resource.mmo.world_id =~ \"$world\") } | quantile_over_time(duration, 0.99) by (name, resource.mmo.role)",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
