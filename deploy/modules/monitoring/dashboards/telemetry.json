    {
      "id": 6,
      "type": "traces",
      "title": "Login join traces",
      "description": "Login, join and spawn operations. Open a row in Explore, then follow its trace-to-log or trace-to-profile links.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "editorMode": "code",
          "limit": 30,
          "query": "{ resource.deployment.environment.name =~ \"$environment\" && resource.k8s.cluster.name =~ \"$cluster\" && resource.mmo.role = \"login\" && resource.service.name = \"errantry-login\" && resource.k8s.pod.name =~ \"$pod\" && name =~ \"(?i).*(login|join|spawn|ticket).*\" }",
          "queryType": "traceqlSearch",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "targetBlank": false,
              "title": "Open login trace in Explore",
              "url": "/explore?orgId=1&left=%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22${__value.raw}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D"
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "traces",
      "title": "Coordinator transition / conflict / error traces",
      "description": "Coordinator store, transition and conflict operations, plus any coordinator error span.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "editorMode": "code",
          "limit": 30,
          "query": "{ resource.deployment.environment.name =~ \"$environment\" && resource.k8s.cluster.name =~ \"$cluster\" && resource.service.name = \"errantry-world\" && resource.mmo.role = \"coordinator\" && (resource.mmo.world_id = nil || resource.mmo.world_id =~ \"$world\") && resource.k8s.pod.name =~ \"$pod\" && (name =~ \"(?i).*(coordinator|transition|conflict|store).*\" || status = error || (span.outcome != nil && span.outcome =~ \"(?i)(error|failed|transport|status|body|retry|retryable|fenced|conflict)\")) }",
          "queryType": "traceqlSearch",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "options": {}
    },
    {
      "id": 8,
      "type": "traces",
      "title": "Fleet pass / action errors",
      "description": "Fleet reconciliation passes and Kubernetes actions, scoped to error status.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "editorMode": "code",
          "limit": 30,
          "query": "{ resource.deployment.environment.name =~ \"$environment\" && resource.k8s.cluster.name =~ \"$cluster\" && resource.service.name = \"errantry-world\" && resource.mmo.role = \"fleet\" && (resource.mmo.world_id = nil || resource.mmo.world_id =~ \"$world\") && resource.k8s.pod.name =~ \"$pod\" && (status = error || (span.outcome != nil && span.outcome =~ \"(?i)(error|failed|transport|status|body|retry)\")) }",
          "queryType": "traceqlSearch",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "options": {}
    },
    {
      "id": 9,
      "type": "traces",
      "title": "Host attach / cut / placement errors",
      "description": "Host attachment, mailbox, world-cut and player-placement error traces.",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "editorMode": "code",
          "limit": 30,
          "query": "{ resource.deployment.environment.name =~ \"$environment\" && resource.k8s.cluster.name =~ \"$cluster\" && resource.service.name = \"errantry-world\" && resource.mmo.role = \"host\" && (resource.mmo.world_id = nil || resource.mmo.world_id =~ \"$world\") && resource.k8s.pod.name =~ \"$pod\" && (name =~ \"(?i).*(attach|mailbox|cut|placement|spawn).*\" || status = error || (span.outcome != nil && span.outcome =~ \"(?i)(error|failed|transport|status|body|pin|refused|retry|fenced|stale_generation)\")) }",
          "queryType": "traceqlSearch",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "options": {}
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Correlated logs by trace_id",
      "description": "Enter the 32-digit trace ID from Tempo in the trace_id variable. Loki's derived field uses the same exact trace_id=<hex> text.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "{cluster=~\"$cluster\",pod=~\"$pod\",container=~\"$role\"} |= \"trace_id=$trace_id\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Recent warnings and errors",
      "description": "Recent WARN/ERROR lines for the selected cluster, pod and process role.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "{cluster=~\"$cluster\",pod=~\"$pod\",container=~\"$role\"} |~ \"(?i)\\\\b(warn|error)\\\\b\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 12,
      "type": "flamegraph",
      "title": "Selected pod CPU profile",
      "description": "CPU profile for the selected service and role. Keep the dashboard time range aligned with a trace while inspecting its pod.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${DS_PYROSCOPE}"
      },
      "gridPos": {
        "x": 0,
        "y": 61,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "${DS_PYROSCOPE}"
          },
          "groupBy": [],
          "labelSelector": "{service_name=~\"$service\",role=~\"$role\",environment=~\"$environment\",cluster=~\"$cluster\",pod=~\"$pod\"}",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "queryType": "profile",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 13,
      "type": "flamegraph",
      "title": "World CPU profile role comparison",
      "description": "The selected world, split by role. This second view keeps a world peer beside the trace's selected pod.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${DS_PYROSCOPE}"
      },
      "gridPos": {
        "x": 12,
        "y": 61,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "${DS_PYROSCOPE}"
          },
          "groupBy": [
            "role"
          ],
          "labelSelector": "{service_name=\"errantry-world\",role=~\"$role|$compare_role\",environment=~\"$environment\",cluster=~\"$cluster\",world_id=~\"$world\"}",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "queryType": "profile",
          "refId": "A"
        }
      ],
      "options": {}
    }
  ],
