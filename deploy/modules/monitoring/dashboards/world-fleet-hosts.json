      "type": "link",
      "url": "/alerting/list?search=WorldFleet&view=state"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Desired rows / host Deployments / Ready",
      "description": "A transient difference is normal during scale and drain. A drained host remains a desired object until removal and may be intentionally unready.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace) (mmo_fleet_wanted{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"}) + max by (namespace) (mmo_fleet_draining{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"})",
          "legendFormat": "desired rows {{namespace}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace) (mmo_fleet_deployments{cluster=~\"$cluster\",role=\"fleet\",namespace=~\"$namespace\"})",
          "legendFormat": "Deployments {{namespace}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count by (namespace) (kube_deployment_status_replicas_ready{cluster=~\"$cluster\",namespace=~\"$namespace\",deployment=~\"host-.*\"} > 0)",
          "legendFormat": "Ready {{namespace}}",
          "range": true,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fleet pass age",
      "description": "The reconciler readiness contract is approximately 6 seconds from its last pass without a failed read or action.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace) (mmo_fleet_pass_age_ms{cluster=~\"$cluster\",role=\"fleet\",namespace=~\"$namespace\"}) / 1000 and on (namespace) (max by (namespace) (kube_deployment_spec_replicas{cluster=~\"$cluster\",namespace=~\"$namespace\",deployment=\"fleet\"}) > 0)",
          "legendFormat": "{{namespace}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 6
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Live hosts / coordinator desired",
      "description": "Live hosts are dirty store rows from the ticker. Draining and stopped worlds explain temporary differences.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace) (mmo_hosts_live{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"} and on (namespace,pod) (mmo_coordinator_is_ticker{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"} == 1))",
          "legendFormat": "live {{namespace}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace) (mmo_fleet_wanted{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"})",
          "legendFormat": "wanted {{namespace}}",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Host load high-water",
      "description": "Worst tick over heartbeat window. 600‰ is the fleet scale-up boundary; persistent >=600 on the least-loaded host is an alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace) (mmo_host_load_tick_permille{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} and on (namespace,pod) (mmo_registered{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} == 1)) / 10",
          "legendFormat": "{{namespace}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Coordinator links up",
      "description": "Registered hosts whose coordinator WorldLink is up. This does not infer host-to-host peer links.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (mmo_world_link_up{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} and on (namespace,pod) (mmo_registered{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} == 1))",
          "legendFormat": "links up {{namespace}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (mmo_registered{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"})",
          "legendFormat": "registered {{namespace}}",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Desired versus actual",
      "description": "Coordinator wanted/draining, reconciler desired/deployments, and Ready host objects on one timeline.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace) (mmo_fleet_wanted{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"})",
          "legendFormat": "wanted {{namespace}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace) (mmo_fleet_draining{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"})",
          "legendFormat": "draining {{namespace}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace) (mmo_fleet_desired{cluster=~\"$cluster\",role=\"fleet\",namespace=~\"$namespace\"})",
          "legendFormat": "reconciler desired {{namespace}}",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace) (mmo_fleet_deployments{cluster=~\"$cluster\",role=\"fleet\",namespace=~\"$namespace\"})",
          "legendFormat": "Deployments {{namespace}}",
          "range": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "count by (namespace) (kube_deployment_status_replicas_ready{cluster=~\"$cluster\",namespace=~\"$namespace\",deployment=~\"host-.*\"} > 0)",
          "legendFormat": "Ready {{namespace}}",
