    {
      "id": 10,
      "type": "timeseries",
      "title": "Host registration and coordinator reattach",
      "description": "Registration is aggregate host readiness; reattach rate helps correlate host link churn with coordinator mailbox/API failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (mmo_registered{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"})",
          "legendFormat": "registered {{namespace}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (mmo_world_link_up{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} and on (namespace,pod) (mmo_registered{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} == 1))",
          "legendFormat": "links up {{namespace}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
