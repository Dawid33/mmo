            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (rate(mmo_fleet_created_total{cluster=~\"$cluster\",role=\"fleet\",namespace=~\"$namespace\"}[5m])) * 60",
          "legendFormat": "objects created/min {{namespace}}",
          "range": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (rate(mmo_fleet_deleted_total{cluster=~\"$cluster\",role=\"fleet\",namespace=~\"$namespace\"}[5m])) * 60",
          "legendFormat": "objects deleted/min {{namespace}}",
          "range": true,
          "refId": "E"
        },
        {
          "datasource": {
