  "description": "Coordinator fleet demand, reconciler objects, dynamic host readiness, load, land ownership and coordinator-link health.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
