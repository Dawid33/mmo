          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Host tick, players and regions",
      "description": "Aggregate max/min tick load and summed sessions/regions by world. Registered hosts only.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (namespace) (mmo_host_load_tick_permille{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} and on (namespace,pod) (mmo_registered{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} == 1)) / 10",
          "legendFormat": "max tick % {{namespace}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "min by (namespace) (mmo_host_load_tick_permille{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} and on (namespace,pod) (mmo_registered{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} == 1)) / 10",
          "legendFormat": "min tick % {{namespace}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (mmo_host_load_players{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} and on (namespace,pod) (mmo_registered{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} == 1))",
          "legendFormat": "players {{namespace}}",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (mmo_host_load_regions{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} and on (namespace,pod) (mmo_registered{cluster=~\"$cluster\",role=\"host\",namespace=~\"$namespace\"} == 1))",
          "legendFormat": "regions {{namespace}}",
          "range": true,
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/tick/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/players|regions/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
