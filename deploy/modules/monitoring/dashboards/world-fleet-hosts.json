        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Fleet and reconciler actions",
      "description": "Rates by action. Raw cumulative counters are not used as values.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (rate(mmo_fleet_added_total{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"}[5m])) * 60",
          "legendFormat": "desired added/min {{namespace}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (rate(mmo_fleet_drained_total{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"}[5m])) * 60",
          "legendFormat": "desired drained/min {{namespace}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (rate(mmo_fleet_removed_total{cluster=~\"$cluster\",role=\"coordinator\",namespace=~\"$namespace\"}[5m])) * 60",
