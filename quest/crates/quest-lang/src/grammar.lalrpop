// The quest script grammar (plan D11). LALRPOP generates an LR(1) parser from it at build time; the
// build fails on any conflict, and none is suppressed.
//
// Tokens come from `lex()` (the logos scanner + the layout pass); the location of a token is its index
// in the token slice, which `parse.rs` maps back to line and column. Every action builds its node
// through a helper of `parse.rs` that records the node's span and depth and refuses a node deeper than
// `PARSE_DEPTH_MAX` (`too-deep`).
//
// Recovery (plan D11): every indented block (and the file's top level) is a list of entries; an entry
// that fails to parse becomes the error token `!`, which takes the rest of its line and the indented
// block under it (`Skipped`), or stands before the block's `DEDENT`. Only line ends and block edges
// follow a `!`, so LALRPOP drops the tokens of the broken line and recovers in the innermost block — never
// by popping an enclosing one. The error is recorded in `errs` and the parse goes on.
//
// Expression precedence, one tier per level, loosest first:
//   Expr (`else` fallback) · OrExpr · AndExpr · NotExpr · CmpExpr (not chainable) · SumExpr · ProdExpr ·
//   Unary (`-` `&` `*`) · PostExpr (`await`) · Plain / Tried (call, `.name`, `[i]`, `[a:b]`; `?`).
// `::` is part of a path (a primary), not an operator. Types and patterns are separate nonterminals,
// reached only from their own positions, so `list[int]` never meets indexing.

use crate::ast::{
    Arg, BinOp, Case, ChoiceOption, Cond, Decorator, Dialogue, DialogueEntry, DialogueKind, ExitArm, Expr,
    ExprKind, Field, File, FnDef, GroupMember, Item, ItemKind, Let, LineId, Node, Objective, OptionMark,
    Param, Part, PartAnchor, Path, PatField, PatLit, Pattern, PatternKind, Quest, Receiver, Role, Span,
    Step, StepKind, Stmt, StmtKind, Topic, Type, TypeKind, UnOp, UseImport, Variant,
};
use crate::diag::Diagnostic;
use crate::lex::{FPart, Tok, Token};
use crate::parse::{
    binary, chained, emit_stmt, expr, fstring, group_entries, group_steps, item, line, lit_pat, paren, pat,
    path_pat, raises, recovered, span, step, stmt, suffix, ticks, ty, unary, Ctx, ParseFail, Suffix,
};

grammar<'t, 'e>(toks: &'t [Token], file: &'t str, errs: &'e mut Vec<Diagnostic>);

extern {
    type Location = usize;
    type Error = ParseFail;

    enum Tok {
        INDENT => Tok::Indent,
        DEDENT => Tok::Dedent,
        NEWLINE => Tok::Newline,
        EOF => Tok::Eof,
        "fn" => Tok::Fn,
        "let" => Tok::Let,
        "if" => Tok::If,
        "elif" => Tok::Elif,
        "else" => Tok::Else,
        "while" => Tok::While,
        "for" => Tok::For,
        "in" => Tok::In,
        "not" => Tok::Not,
        "and" => Tok::And,
        "or" => Tok::Or,
        "return" => Tok::Return,
        "break" => Tok::Break,
        "continue" => Tok::Continue,
        "pass" => Tok::Pass,
        "match" => Tok::Match,
        "case" => Tok::Case,
        "struct" => Tok::Struct,
        "impl" => Tok::Impl,
        "enum" => Tok::Enum,
        "error" => Tok::Error,
        "mod" => Tok::Mod,
        "use" => Tok::Use,
        "pub" => Tok::Pub,
        "as" => Tok::As,
        "raise" => Tok::Raise,
        "await" => Tok::Await,
        "self" => Tok::SelfKw,
        "crate" => Tok::Crate,
        "super" => Tok::Super,
        "true" => Tok::True,
        "false" => Tok::False,
        "dialogue" => Tok::Dialogue,
        "quest" => Tok::Quest,
        "choice" => Tok::Choice,
        "once" => Tok::Once,
        "when" => Tok::When,
        "where" => Tok::Where,
        "node" => Tok::Node,
        "stage" => Tok::Stage,
        "role" => Tok::Role,
        "objective" => Tok::Objective,
        "event" => Tok::Event,
        "emit" => Tok::Emit,
        "detour" => Tok::Detour,
        "default" => Tok::Default,
        "per" => Tok::Per,
        "at" => Tok::AtKw,
        "topic" => Tok::Topic,
        "priority" => Tok::Priority,
        "part" => Tok::Part,
        "scene" => Tok::Scene,
        "requires" => Tok::Requires,
        "pause" => Tok::Pause,
        "optional" => Tok::Optional,
        "repeatable" => Tok::Repeatable,
        "exits" => Tok::Exits,
        "count" => Tok::Count,
        "uninterruptible" => Tok::Uninterruptible,
        "on" => Tok::On,
        "(" => Tok::LParen,
        ")" => Tok::RParen,
        "[" => Tok::LBracket,
        "]" => Tok::RBracket,
        "{" => Tok::LBrace,
        "}" => Tok::RBrace,
        "," => Tok::Comma,
        ":" => Tok::Colon,
        "::" => Tok::ColonColon,
        "." => Tok::Dot,
        "@" => Tok::At,
        "=" => Tok::Assign,
        "==" => Tok::EqEq,
        "!=" => Tok::NotEq,
        "<" => Tok::Lt,
        "<=" => Tok::Le,
        ">" => Tok::Gt,
        ">=" => Tok::Ge,
        "+" => Tok::Plus,
        "-" => Tok::Minus,
        "*" => Tok::Star,
        "/" => Tok::Slash,
        "%" => Tok::Percent,
        "&" => Tok::Amp,
        "|" => Tok::Pipe,
        "?" => Tok::Question,
        "->" => Tok::Arrow,
        "=>" => Tok::FatArrow,
        NAME => Tok::Ident(<String>),
        INT => Tok::Int(<i64>),
        FLOAT => Tok::Float(<f64>),
        STRING => Tok::Str(<String>),
        FSTRING => Tok::FString(<Vec<FPart>>),
    }
}

// Entry points.

pub FileEntry: File = {
    EOF => File::default(),
    TopErr EOF => File::default(),
    <items:Entries<TopItem, TopErr>> EOF => File { items },
    <items:Entries<TopItem, TopErr>> TopErr EOF => File { items },
};
pub ExprEntry: Expr = Expr;
pub TypeEntry: Type = Type;
pub PatternEntry: Pattern = Pattern;

// Helpers.

/// Zero or more, separated by commas, with an optional trailing comma.
Comma<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    },
};

/// One or more, separated by commas, with an optional trailing comma.
Comma1<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T> ","? => {
        v.push(e);
        v
    },
};

PathSeg: String = {
    NAME,
    "self" => "self".to_string(),
    "crate" => "crate".to_string(),
    "super" => "super".to_string(),
};

/// The dialogue keywords of spec 5.13, reserved after the module examples of 5.10 were written
/// (`npc::dialogue`): a path may still name a module so — after `::`, or first when `::` follows.
Reserved: String = {
    "dialogue" => "dialogue".to_string(),
    "choice" => "choice".to_string(),
    "once" => "once".to_string(),
    "when" => "when".to_string(),
    "where" => "where".to_string(),
};

FieldName: String = {
    NAME,
    Reserved,
};

/// A segment after `::`, where nothing but a segment can follow.
PathTail: String = {
    PathSeg,
    Reserved,
};

Path: Path = {
    PathSeg => vec![<>],
    <h:Reserved> "::" <s:PathTail> => vec![h, s],
    <mut p:Path> "::" <s:PathTail> => {
        p.push(s);
        p
    },
};

// Expressions.

/// The loosest tier: the error fallback `e else fallback` (right-associative: `a else b else c` tries
/// `b` when `a` fails, and `c` when `b` does).
Expr: Expr = {
    <l:@L> <e:OrExpr> "else" <f:Fallback> <r:@R> =>? expr(toks, l, r, ExprKind::Else(Box::new(e), Box::new(f))),
    OrExpr,
};

/// The right side of `else`: a value, or a way out.
Fallback: Expr = {
    Expr,
    <l:@L> "return" <e:Expr?> <r:@R> =>? expr(toks, l, r, ExprKind::Return(e.map(Box::new))),
    <l:@L> "break" <r:@R> =>? expr(toks, l, r, ExprKind::Break),
    <l:@L> "continue" <r:@R> =>? expr(toks, l, r, ExprKind::Continue),
    <l:@L> "raise" <e:OrExpr> <r:@R> =>? expr(toks, l, r, ExprKind::Raise(Box::new(e))),
};

OrExpr: Expr = {
    <l:@L> <a:OrExpr> "or" <b:AndExpr> <r:@R> =>? binary(toks, l, r, BinOp::Or, a, b),
    AndExpr,
};

AndExpr: Expr = {
    <l:@L> <a:AndExpr> "and" <b:NotExpr> <r:@R> =>? binary(toks, l, r, BinOp::And, a, b),
    NotExpr,
};

NotExpr: Expr = {
    <l:@L> "not" <e:NotExpr> <r:@R> =>? unary(toks, l, r, UnOp::Not, e),
    CmpExpr,
};

/// One comparison at most: each further operator is `chained-comparison` (recorded; the parse goes on
/// with the first comparison).
CmpExpr: Expr = {
    SumExpr,
    Comparison,
    Chain,
};

Chain: Expr = {
    <c:Comparison> <at:@L> CmpOp SumExpr => chained(errs, toks, file, at, c),
    <c:Chain> <at:@L> CmpOp SumExpr => chained(errs, toks, file, at, c),
};

Comparison: Expr = {
    <l:@L> <a:SumExpr> <op:CmpOp> <b:SumExpr> <r:@R> =>? binary(toks, l, r, op, a, b),
};

CmpOp: BinOp = {
    "==" => BinOp::Eq,
    "!=" => BinOp::Ne,
    "<" => BinOp::Lt,
    "<=" => BinOp::Le,
    ">" => BinOp::Gt,
    ">=" => BinOp::Ge,
    "in" => BinOp::In,
    "not" "in" => BinOp::NotIn,
};

SumExpr: Expr = {
    <l:@L> <a:SumExpr> <op:SumOp> <b:ProdExpr> <r:@R> =>? binary(toks, l, r, op, a, b),
    ProdExpr,
};

SumOp: BinOp = {
    "+" => BinOp::Add,
    "-" => BinOp::Sub,
};

ProdExpr: Expr = {
    <l:@L> <a:ProdExpr> <op:ProdOp> <b:Unary> <r:@R> =>? binary(toks, l, r, op, a, b),
    Unary,
};

ProdOp: BinOp = {
    "*" => BinOp::Mul,
    "/" => BinOp::Div,
    "%" => BinOp::Rem,
};

Unary: Expr = {
    <l:@L> "-" <e:Unary> <r:@R> =>? unary(toks, l, r, UnOp::Neg, e),
    <l:@L> "&" <e:Unary> <r:@R> =>? unary(toks, l, r, UnOp::Ref, e),
    <l:@L> "*" <e:Unary> <r:@R> =>? unary(toks, l, r, UnOp::Deref, e),
    PostExpr,
};

/// `await` takes a postfix chain without `?` (`Plain`); a `?` after it applies to the awaited result,
/// and anything after that `?` continues the chain (`Tried`).
PostExpr: Expr = {
    Plain,
    <l:@L> "await" <e:Plain> <r:@R> =>? expr(toks, l, r, ExprKind::Await(Box::new(e))),
    Tried,
};

/// A postfix chain that has passed a `?` (or an `await`).
Tried: Expr = {
    <l:@L> <e:PostExpr> "?" <r:@R> =>? expr(toks, l, r, ExprKind::Try(Box::new(e))),
    <l:@L> <e:Tried> <s:Suffix> <r:@R> =>? suffix(toks, l, r, e, s),
};

/// A postfix chain with no `?` and no `await`.
Plain: Expr = {
    Primary,
    <l:@L> <e:Plain> <s:Suffix> <r:@R> =>? suffix(toks, l, r, e, s),
};

Suffix: Suffix = {
    "(" <Comma<Arg>> ")" => Suffix::Call(<>),
    // A field may be named by a reserved dialogue word (`DialogueEnded`'s `e.dialogue`).
    "." <FieldName> => Suffix::Field(<>),
    "[" <i:Expr> "]" => Suffix::Index(i),
    "[" <a:Expr?> ":" <b:Expr?> "]" => Suffix::Slice(a, b),
};

Arg: Arg = {
    <value:Expr> => Arg { name: None, value },
    <n:NAME> "=" <value:Expr> => Arg { name: Some(n), value },
};

Primary: Expr = {
    <l:@L> <v:INT> <r:@R> =>? expr(toks, l, r, ExprKind::Int(v)),
    <l:@L> <v:FLOAT> <r:@R> =>? expr(toks, l, r, ExprKind::Float(v)),
    <l:@L> <v:STRING> <r:@R> =>? expr(toks, l, r, ExprKind::Str(v)),
    <l:@L> <v:FSTRING> <r:@R> =>? {
        let kind = fstring(errs, toks, file, l, v);
        expr(toks, l, r, kind)
    },
    <l:@L> "true" <r:@R> =>? expr(toks, l, r, ExprKind::Bool(true)),
    <l:@L> "false" <r:@R> =>? expr(toks, l, r, ExprKind::Bool(false)),
    <l:@L> <p:Path> <r:@R> =>? expr(toks, l, r, ExprKind::Path(p)),
    <l:@L> "(" ")" <r:@R> =>? expr(toks, l, r, ExprKind::Unit),
    <l:@L> "(" <e:Expr> ")" =>? paren(e, l),
    <l:@L> "[" <items:Comma<Expr>> "]" <r:@R> =>? expr(toks, l, r, ExprKind::List(items)),
    <l:@L> "{" <entries:Comma<DictEntry>> "}" <r:@R> =>? expr(toks, l, r, ExprKind::Dict(entries)),
};

DictEntry: (Expr, Expr) = {
    <k:Expr> ":" <v:Expr> => (k, v),
};

// Types.

Type: Type = {
    <l:@L> "(" ")" <r:@R> =>? ty(toks, l, r, TypeKind::Unit),
    <l:@L> "&" <t:Type> <r:@R> =>? ty(toks, l, r, TypeKind::Ref(Box::new(t))),
    <l:@L> <p:Path> <r:@R> =>? ty(toks, l, r, TypeKind::Named(p, Vec::new())),
    <l:@L> <p:Path> "[" <args:Comma1<Type>> "]" <r:@R> =>? ty(toks, l, r, TypeKind::Named(p, args)),
};

// Patterns.

Pattern: Pattern = {
    PatSingle,
    <l:@L> <first:PatSingle> <rest:("|" <PatSingle>)+> <r:@R> =>? {
        let mut alts = rest;
        alts.insert(0, first);
        pat(toks, l, r, PatternKind::Or(alts))
    },
};

PatSingle: Pattern = {
    <l:@L> <p:Path> <r:@R> =>? path_pat(toks, l, r, p),
    <l:@L> <p:Path> "(" <fields:Comma<PatField>> ")" <r:@R> =>? pat(toks, l, r, PatternKind::Ctor(p, fields)),
    <l:@L> <v:INT> <r:@R> =>? lit_pat(toks, l, r, PatLit::Int(v)),
    // The lexer never yields a negative literal, so this negation cannot wrap.
    <l:@L> "-" <v:INT> <r:@R> =>? lit_pat(toks, l, r, PatLit::Int(v.wrapping_neg())),
    <l:@L> <v:FLOAT> <r:@R> =>? lit_pat(toks, l, r, PatLit::Float(v)),
    <l:@L> "-" <v:FLOAT> <r:@R> =>? lit_pat(toks, l, r, PatLit::Float(-v)),
    <l:@L> <v:STRING> <r:@R> =>? lit_pat(toks, l, r, PatLit::Str(v)),
    <l:@L> "true" <r:@R> =>? lit_pat(toks, l, r, PatLit::Bool(true)),
    <l:@L> "false" <r:@R> =>? lit_pat(toks, l, r, PatLit::Bool(false)),
};

PatField: PatField = {
    <pattern:Pattern> => PatField { name: None, pattern },
    <n:NAME> "=" <pattern:Pattern> => PatField { name: Some(n), pattern },
};

// Blocks and recovery.

/// The error token in context `Top`, `Stmt`, `Step` or `Other` (see `parse::Ctx`): records the error.
TopErr: () = <e:!> => recovered(errs, toks, file, e, Ctx::Top);
StmtErr: () = <e:!> => recovered(errs, toks, file, e, Ctx::Stmt);
StepErr: () = <e:!> => recovered(errs, toks, file, e, Ctx::Step);
OtherErr: () = <e:!> => recovered(errs, toks, file, e, Ctx::Other);

/// What a broken line leaves: its end, and the indented block under it.
Skipped: () = {
    NEWLINE Continued*,
    NEWLINE Skip Continued*,
    Skip Continued*,
};

/// An `elif` / `else` clause after a broken line: the rest of a broken `if` chain (neither word begins an
/// entry, so this takes nothing a block could use).
Continued: () = ContinuedWord LineTok* NEWLINE Skip?;

ContinuedWord: () = {
    "elif",
    "else",
};

/// An indented block taken whole, unparsed.
Skip: () = INDENT SkipTok* DEDENT;

SkipTok: () = {
    Skip,
    NEWLINE,
    LineTok,
};

/// Any token but a layout one.
LineTok: () = {
    "fn",
    "let",
    "if",
    "elif",
    "else",
    "while",
    "for",
    "in",
    "not",
    "and",
    "or",
    "return",
    "break",
    "continue",
    "pass",
    "match",
    "case",
    "struct",
    "impl",
    "enum",
    "error",
    "mod",
    "use",
    "pub",
    "as",
    "raise",
    "await",
    "self",
    "crate",
    "super",
    "true",
    "false",
    "dialogue",
    "quest",
    "choice",
    "once",
    "when",
    "where",
    "node",
    "stage",
    "role",
    "objective",
    "event",
    "emit",
    "detour",
    "default",
    "per",
    "at",
    "topic",
    "priority",
    "part",
    "scene",
    "requires",
    "pause",
    "optional",
    "repeatable",
    "exits",
    "count",
    "uninterruptible",
    "on",
    "(",
    ")",
    "[",
    "]",
    "{",
    "}",
    ",",
    ":",
    "::",
    ".",
    "@",
    "=",
    "==",
    "!=",
    "<",
    "<=",
    ">",
    ">=",
    "+",
    "-",
    "*",
    "/",
    "%",
    "&",
    "|",
    "?",
    "->",
    "=>",
    NAME,
    INT,
    FLOAT,
    STRING,
    FSTRING,
};

/// One or more `T`s, each a line (or a line and its block); a line that fails is `E` and is skipped.
Entries<T, E>: Vec<T> = {
    <t:T> => vec![t],
    E Skipped => Vec::new(),
    <mut v:Entries<T, E>> <t:T> => {
        v.push(t);
        v
    },
    <v:Entries<T, E>> E Skipped => v,
};

/// An indented block of `T`s. An error right before its end (a missing block, a line cut short by the
/// dedent) is recovered here too.
Block<T, E>: Vec<T> = {
    INDENT <Entries<T, E>> DEDENT,
    INDENT <Entries<T, E>> E DEDENT,
    INDENT E DEDENT => Vec::new(),
};

/// `:` and an indented block of statements.
Suite: Vec<Stmt> = ":" NEWLINE <Block<Stmt, StmtErr>>;

// Statements.

Stmt: Stmt = {
    <l:@L> <k:SimpleStmt> <r:@R> NEWLINE =>? stmt(toks, l, r, k),
    <l:@L> <k:BlockStmt> <r:@R> =>? stmt(toks, l, r, k),
};

LetHead: (String, Option<Type>) = "let" <NAME> <(":" <Type>)?> "=";

/// A statement on one line.
SimpleStmt: StmtKind = {
    <h:LetHead> <value:Expr> => StmtKind::Let(Let { name: h.0, ty: h.1, value }),
    <place:Unary> "=" <value:Expr> => StmtKind::Assign(place, value),
    <Expr> => StmtKind::Expr(<>),
    "pass" => StmtKind::Pass,
    "break" => StmtKind::Break,
    "continue" => StmtKind::Continue,
    "return" <Expr?> => StmtKind::Return(<>),
    "raise" <Expr> => StmtKind::Raise(<>),
    "->" <NAME> => StmtKind::Jump(<>),
    // `emit Event(args)` in a handler is the prelude call `emit(Event(args))`.
    <l:@L> "emit" <p:Path> <at:@L> "(" <args:Comma<Arg>> ")" <r:@R> =>? emit_stmt(toks, l, at, r, p, args),
};

/// A statement that ends with an indented block.
BlockStmt: StmtKind = {
    <h:LetHead> <value:BlockFallback> => StmtKind::Let(Let { name: h.0, ty: h.1, value }),
    <place:Unary> "=" <value:BlockFallback> => StmtKind::Assign(place, value),
    <BlockFallback> => StmtKind::Expr(<>),
    "if" <c:Expr> <b:Suite> <elifs:("elif" <Expr> <Suite>)*> <other:("else" <Suite>)?> => {
        let mut branches = vec![(c, b)];
        branches.extend(elifs);
        StmtKind::If(branches, other)
    },
    "while" <c:Expr> <b:Suite> => StmtKind::While(c, b),
    "for" <first:NAME> <second:("," <NAME>)?> "in" <e:Expr> <b:Suite> => {
        let mut vars = vec![first];
        vars.extend(second);
        StmtKind::For(vars, e, b)
    },
    "match" <e:Expr> ":" NEWLINE <cases:Block<Case, OtherErr>> => StmtKind::Match(e, cases),
};

Case: Case = {
    <l:@L> "case" <pattern:Pattern> <guard:("if" <Expr>)?> <r:@R> <body:Suite> => Case {
        pattern,
        guard,
        body,
        span: span(toks, l, r),
    },
};

/// `e else err:` + block, possibly at the end of a chain: `a else b else err:` is
/// `a else (b else err: …)`.
BlockFallback: Expr = {
    <l:@L> <e:OrExpr> "else" <f:BlockFallbackTail> <r:@R> =>? expr(toks, l, r, ExprKind::Else(Box::new(e), Box::new(f))),
};

BlockFallbackTail: Expr = {
    <l:@L> <n:NAME> ":" NEWLINE <b:Block<Stmt, StmtErr>> <r:@R> =>? expr(toks, l, r, ExprKind::FallbackBlock(n, b)),
    // `e else:` + block: the error is not bound (its binding is `_`).
    <l:@L> ":" NEWLINE <b:Block<Stmt, StmtErr>> <r:@R> =>? expr(toks, l, r, ExprKind::FallbackBlock("_".to_string(), b)),
    BlockFallback,
};

// Items.

/// An item at the top level of a file. `role`, `stage` and `objective` parse here too, so resolution can
/// say they belong in a quest (`quest-only`).
TopItem: Item = {
    <l:@L> <p:"pub"?> <k:ItemBody> <r:@R> =>? item(toks, l, r, Vec::new(), p.is_some(), k),
    <d:Decorator+> <l:@L> <p:"pub"?> <k:DecoratedBody> <r:@R> =>? item(toks, l, r, d, p.is_some(), k),
};

ItemBody: ItemKind = {
    FnItem,
    DialogueItem,
    SceneItem,
    StructItem,
    ImplItem,
    EnumItem,
    ErrorItem,
    ModItem,
    UseItem,
    LetItem,
    EventItem,
    QuestItem,
    RoleItem,
    StageItem,
    ObjectiveItem,
};

DecoratedBody: ItemKind = {
    FnItem,
    DialogueItem,
    SceneItem,
};

Decorator: Decorator = {
    <l:@L> "@" <name:NAME> <args:("(" <Comma<Arg>> ")")?> <r:@R> NEWLINE => Decorator {
        name,
        args: args.unwrap_or_default(),
        span: span(toks, l, r),
    },
};

FnItem: ItemKind = {
    "fn" <name:NAME> "(" <ps:ParamList> ")" <ret:("->" <Type>)?> <raises:Raises?> ":" NEWLINE <body:Block<Stmt, StmtErr>> => {
        ItemKind::Fn(FnDef { name, receiver: ps.0, params: ps.1, ret, raises, body })
    },
};

/// `raises Set` (`raises` is not a keyword: the action checks the word).
Raises: Path = {
    <at:@L> <word:NAME> <set:Path> => raises(errs, toks, file, at, &word, set),
};

ParamList: (Option<Receiver>, Vec<Param>) = {
    <Comma<Param>> => (None, <>),
    <Receiver> => (Some(<>), Vec::new()),
    <r:Receiver> "," <ps:Comma<Param>> => (Some(r), ps),
};

Receiver: Receiver = {
    "self" => Receiver::Value,
    "&" "self" => Receiver::Ref,
};

Param: Param = {
    <l:@L> <name:NAME> <ty:(":" <Type>)?> <r:@R> => Param { name, ty, span: span(toks, l, r) },
};

FieldDecl: Field = {
    <l:@L> <name:NAME> ":" <ty:Type> <r:@R> => Field { name, ty, span: span(toks, l, r) },
};

FieldLine: Field = <FieldDecl> NEWLINE;

StructItem: ItemKind = {
    "struct" <name:NAME> ":" NEWLINE <fields:Block<FieldLine, OtherErr>> => ItemKind::Struct(name, fields),
};

EventItem: ItemKind = {
    "event" <name:NAME> ":" NEWLINE <fields:Block<FieldLine, OtherErr>> => ItemKind::Event(name, fields),
};

ImplItem: ItemKind = {
    "impl" <name:NAME> ":" NEWLINE <fns:Block<Method, OtherErr>> => ItemKind::Impl(name, fns),
};

Method: Item = {
    <l:@L> <p:"pub"?> <k:FnItem> <r:@R> =>? item(toks, l, r, Vec::new(), p.is_some(), k),
    <d:Decorator+> <l:@L> <p:"pub"?> <k:FnItem> <r:@R> =>? item(toks, l, r, d, p.is_some(), k),
};

/// A variant or an error-set member: a name, with fields when it carries data.
Variant: Variant = {
    <l:@L> <name:NAME> <fields:("(" <Comma1<FieldDecl>> ")")?> <r:@R> => Variant {
        name,
        fields: fields.unwrap_or_default(),
        span: span(toks, l, r),
    },
};

VariantLine: Variant = <Variant> NEWLINE;

EnumItem: ItemKind = {
    "enum" <name:NAME> ":" NEWLINE <vs:Block<VariantLine, OtherErr>> => ItemKind::Enum(name, vs),
};

ErrorItem: ItemKind = {
    "error" <name:NAME> "=" <first:Variant> <rest:("|" <Variant>)*> NEWLINE => {
        let mut members = vec![first];
        members.extend(rest);
        ItemKind::ErrorSet(name, members)
    },
};

ModItem: ItemKind = {
    "mod" <PathTail> NEWLINE => ItemKind::Mod(<>),
};

UseItem: ItemKind = {
    "use" <UseTree> NEWLINE => ItemKind::Use(<>),
};

UseTree: Vec<UseImport> = {
    <l:@L> <path:UsePath> <alias:("as" <NAME>)?> <r:@R> => vec![UseImport { path, alias, span: span(toks, l, r) }],
    <prefix:UsePath> "::" "{" <leaves:Comma1<UseLeaf>> "}" => leaves
        .into_iter()
        .map(|mut u| {
            let mut path = prefix.clone();
            path.append(&mut u.path);
            u.path = path;
            u
        })
        .collect(),
};

/// A `use` path: any segment may be a reserved dialogue word (`use dialogue::x`).
UsePath: Path = {
    PathTail => vec![<>],
    <mut p:UsePath> "::" <s:PathTail> => {
        p.push(s);
        p
    },
};

UseLeaf: UseImport = {
    <l:@L> <s:PathTail> <alias:("as" <NAME>)?> <r:@R> => UseImport { path: vec![s], alias, span: span(toks, l, r) },
};

LetItem: ItemKind = {
    <h:LetHead> <value:Expr> NEWLINE => ItemKind::Let(Let { name: h.0, ty: h.1, value }),
    <h:LetHead> <value:BlockFallback> => ItemKind::Let(Let { name: h.0, ty: h.1, value }),
};

// Quests (spec 5.12).

QuestItem: ItemKind = {
    <rep:"repeatable"?> "quest" <name:NAME> <options:("(" <Comma<Arg>> ")")?> <at:("at" <NAME>)?> ":" NEWLINE <body:Block<QuestMember, OtherErr>> => {
        ItemKind::Quest(Quest { name, repeatable: rep.is_some(), options: options.unwrap_or_default(), at, body })
    },
};

/// A member of a quest (or a part: resolution says which members a part may not hold). An `objective`
/// parses here too, so resolution can say it belongs in a stage.
QuestMember: Item = {
    <l:@L> <k:QuestOnly> <r:@R> =>? item(toks, l, r, Vec::new(), false, k),
    <d:Decorator*> <l:@L> <k:DialogueLike> <r:@R> =>? item(toks, l, r, d, false, k),
    <d:Decorator+> <l:@L> <k:FnItem> <r:@R> =>? item(toks, l, r, d, false, k),
};

QuestOnly: ItemKind = {
    RoleItem,
    LetItem,
    EventItem,
    StageItem,
    ObjectiveItem,
    RequiresItem,
    PartItem,
};

DialogueLike: ItemKind = {
    DialogueItem,
    SceneItem,
};

RequiresItem: ItemKind = {
    "requires" <Expr> NEWLINE => ItemKind::Requires(<>),
};

RoleItem: ItemKind = {
    <opt:"optional"?> "role" <name:NAME> ":" <ty:Type> <cond:("where" <Expr>)?> NEWLINE => {
        ItemKind::Role(Role { name, ty, cond, optional: opt.is_some() })
    },
};

StageItem: ItemKind = {
    "stage" <name:NAME> ":" NEWLINE <members:Block<StageMember, OtherErr>> => ItemKind::Stage(name, members),
};

StageMember: Item = {
    <l:@L> <k:ObjectiveItem> <r:@R> =>? item(toks, l, r, Vec::new(), false, k),
    <l:@L> <k:TransitionItem> <r:@R> =>? item(toks, l, r, Vec::new(), false, k),
    <d:Decorator*> <l:@L> <k:DialogueLike> <r:@R> =>? item(toks, l, r, d, false, k),
    <d:Decorator+> <l:@L> <k:FnItem> <r:@R> =>? item(toks, l, r, d, false, k),
};

/// `-> Stage when cond` as a stage member (inside a handler `-> Stage` is a statement).
TransitionItem: ItemKind = {
    "->" <stage:NAME> "when" <cond:Expr> NEWLINE => ItemKind::Transition(stage, cond),
};

ObjectiveItem: ItemKind = {
    <opt:"optional"?> "objective" <name:NAME> <text:LineText> <id:LineId?> <at:("at" <Expr>)?> <count:("count" <Expr>)?> NEWLINE => {
        ItemKind::Objective(Objective { name, text, id, at, count, optional: opt.is_some() })
    },
};

PartItem: ItemKind = {
    "part" <name:NAME> <anchor:PartAnchor> <role:NAME> ":" NEWLINE <body:Block<QuestMember, OtherErr>> => {
        ItemKind::Part(Part { name, anchor, role, body })
    },
};

PartAnchor: PartAnchor = {
    "on" => PartAnchor::On,
    "at" => PartAnchor::At,
};

// Dialogue (spec 5.11): a body of nodes or steps, never statements.

DialogueItem: ItemKind = {
    "dialogue" <name:NAME> "(" <params:Comma<Param>> ")" <target:DialogueTarget?> <topic:Topic?> <exits:("exits" <Comma1<ExitName>>)?> ":" NEWLINE <body:Block<DialogueEntry, StepErr>> => {
        let (target, filter) = match target {
            Some((t, f)) => (Some(t), f),
            None => (None, None),
        };
        ItemKind::Dialogue(Dialogue {
            kind: DialogueKind::Conversation,
            name,
            params,
            target,
            filter,
            topic,
            exits: exits.unwrap_or_default(),
            cast_cond: None,
            uninterruptible: false,
            body: group_entries(body),
        })
    },
};

/// `for target [where filter]`. Before `where` the target is an `OrExpr`: after `for a else return`, a
/// `where` would begin a path (`where::x`), so the target takes no `else` when a filter follows.
DialogueTarget: (Expr, Option<Expr>) = {
    "for" <Expr> => (<>, None),
    "for" <t:OrExpr> "where" <f:Expr> => (t, Some(f)),
};

ExitName: (String, Span) = {
    <l:@L> <n:NAME> <r:@R> => (n, span(toks, l, r)),
};

/// `scene name(cast) [where cond] [uninterruptible]:` + steps.
SceneItem: ItemKind = {
    "scene" <name:NAME> "(" <params:Comma<Param>> ")" <cast_cond:("where" <Expr>)?> <u:"uninterruptible"?> ":" NEWLINE <body:Block<DialogueEntry, StepErr>> => {
        ItemKind::Scene(Dialogue {
            kind: DialogueKind::Scene,
            name,
            params,
            target: None,
            filter: None,
            topic: None,
            exits: Vec::new(),
            cast_cond,
            uninterruptible: u.is_some(),
            body: group_entries(body),
        })
    },
};

Topic: Topic = {
    <l:@L> "topic" <text:LineText> <id:LineId?> <cond:("if" <Expr>)?> <priority:("priority" <INT>)?> <r:@R> => Topic {
        text,
        id,
        cond,
        priority,
        span: span(toks, l, r),
    },
};

DialogueEntry: DialogueEntry = {
    <l:@L> "node" <name:NAME> <cond:("when" <Cond>)?> <r:@R> ":" NEWLINE <steps:StepBlock> => DialogueEntry::Node(Node {
        name,
        cond,
        steps,
        span: span(toks, l, r),
    }),
    Step => DialogueEntry::Step(<>),
};

StepBlock: Vec<Step> = <Block<Step, StepErr>> => group_steps(<>);

Step: Step = {
    <l:@L> <line:Line> <r:@R> NEWLINE =>? step(toks, l, r, StepKind::Line(line)),
    <l:@L> "choice" <args:("(" <Comma<Arg>> ")")?> <r:@R> ":" NEWLINE <options:Block<ChoiceOption, OtherErr>> =>? {
        step(toks, l, r, StepKind::Choice(args.unwrap_or_default(), options))
    },
    <l:@L> "=>" <line:Line> <r:@R> NEWLINE =>? {
        let member = GroupMember { line, steps: Vec::new(), span: span(toks, l, r) };
        step(toks, l, r, StepKind::Group(vec![member]))
    },
    <l:@L> "=>" <line:Line> <r:@R> ":" NEWLINE <steps:StepBlock> =>? {
        let member = GroupMember { line, steps, span: span(toks, l, r) };
        step(toks, l, r, StepKind::Group(vec![member]))
    },
    <l:@L> "when" <c:Cond> <r:@R> ":" NEWLINE <steps:StepBlock> =>? step(toks, l, r, StepKind::When(c, steps)),
    <l:@L> "once" <per:("per" <Expr>)?> <r:@R> ":" NEWLINE <steps:StepBlock> =>? step(toks, l, r, StepKind::Once(per, steps)),
    <l:@L> "->" <n:NAME> <r:@R> NEWLINE =>? step(toks, l, r, StepKind::Jump(n)),
    <l:@L> "detour" <n:NAME> <r:@R> NEWLINE =>? step(toks, l, r, StepKind::Detour(n, Vec::new())),
    <l:@L> "detour" <n:NAME> <r:@R> ":" NEWLINE <arms:Block<ExitArm, OtherErr>> =>? step(toks, l, r, StepKind::Detour(n, arms)),
    <l:@L> "emit" <p:Path> "(" <args:Comma<Arg>> ")" <r:@R> NEWLINE =>? step(toks, l, r, StepKind::Emit(p, args)),
    <l:@L> "return" <exit:NAME?> <r:@R> NEWLINE =>? step(toks, l, r, StepKind::Return(exit)),
    <l:@L> "pause" <e:Expr> <r:@R> NEWLINE =>? step(toks, l, r, StepKind::Pause(e)),
};

/// An arm of `detour name:`: `exit:` + steps.
ExitArm: ExitArm = {
    <l:@L> <exit:NAME> <r:@R> ":" NEWLINE <steps:StepBlock> => ExitArm { exit, steps, span: span(toks, l, r) },
};

/// `[speaker:] "text" [@id] [(ticks=n)] [when cond]`.
Line: crate::ast::Line = {
    <l:@L> <speaker:(<NAME> ":")?> <text:LineText> <id:LineId?> <ticks:("(" <Ticks> ")")?> <cond:("when" <Cond>)?> <r:@R> => line(toks, l, r, speaker, text, id, ticks, cond),
};

/// `ticks=n` (`ticks` is not a keyword: the action checks the word).
Ticks: Expr = {
    <at:@L> <word:NAME> "=" <e:Expr> => ticks(errs, toks, file, at, &word, e),
};

/// A string or f-string literal: the text of a line, an option, an objective or a topic.
LineText: Expr = {
    <l:@L> <v:STRING> <r:@R> =>? expr(toks, l, r, ExprKind::Str(v)),
    <l:@L> <v:FSTRING> <r:@R> =>? {
        let kind = fstring(errs, toks, file, l, v);
        expr(toks, l, r, kind)
    },
};

LineId: LineId = {
    <l:@L> "@" <first:IdSeg> <rest:("." <IdSeg>)*> <r:@R> => {
        let mut path = vec![first];
        path.extend(rest);
        LineId { path, span: span(toks, l, r) }
    },
};

/// A segment of a line id: a name or any word (`@lostdog.return`).
IdSeg: String = {
    NAME,
    "fn" => "fn".to_string(),
    "let" => "let".to_string(),
    "if" => "if".to_string(),
    "elif" => "elif".to_string(),
    "else" => "else".to_string(),
    "while" => "while".to_string(),
    "for" => "for".to_string(),
    "in" => "in".to_string(),
    "not" => "not".to_string(),
    "and" => "and".to_string(),
    "or" => "or".to_string(),
    "return" => "return".to_string(),
    "break" => "break".to_string(),
    "continue" => "continue".to_string(),
    "pass" => "pass".to_string(),
    "match" => "match".to_string(),
    "case" => "case".to_string(),
    "struct" => "struct".to_string(),
    "impl" => "impl".to_string(),
    "enum" => "enum".to_string(),
    "error" => "error".to_string(),
    "mod" => "mod".to_string(),
    "use" => "use".to_string(),
    "pub" => "pub".to_string(),
    "as" => "as".to_string(),
    "raise" => "raise".to_string(),
    "await" => "await".to_string(),
    "self" => "self".to_string(),
    "crate" => "crate".to_string(),
    "super" => "super".to_string(),
    "true" => "true".to_string(),
    "false" => "false".to_string(),
    "dialogue" => "dialogue".to_string(),
    "quest" => "quest".to_string(),
    "choice" => "choice".to_string(),
    "once" => "once".to_string(),
    "when" => "when".to_string(),
    "where" => "where".to_string(),
    "node" => "node".to_string(),
    "stage" => "stage".to_string(),
    "role" => "role".to_string(),
    "objective" => "objective".to_string(),
    "event" => "event".to_string(),
    "emit" => "emit".to_string(),
    "detour" => "detour".to_string(),
    "default" => "default".to_string(),
    "per" => "per".to_string(),
    "at" => "at".to_string(),
    "topic" => "topic".to_string(),
    "priority" => "priority".to_string(),
    "part" => "part".to_string(),
    "scene" => "scene".to_string(),
    "requires" => "requires".to_string(),
    "pause" => "pause".to_string(),
    "optional" => "optional".to_string(),
    "repeatable" => "repeatable".to_string(),
    "exits" => "exits".to_string(),
    "count" => "count".to_string(),
    "uninterruptible" => "uninterruptible".to_string(),
    "on" => "on".to_string(),
};

/// `once [per e] [if e]`, or an expression. The language has no conditional expression, so `if` ends
/// the `per` expression.
Cond: Cond = {
    "once" <per:("per" <Expr>)?> <guard:("if" <Expr>)?> => Cond::Once { per, guard },
    Expr => Cond::Expr(<>),
};

ChoiceOption: ChoiceOption = {
    <l:@L> <mark:OptionMark?> <text:LineText> <id:LineId?> <guard:("if" <Expr>)?> <r:@R> NEWLINE => ChoiceOption {
        mark,
        text: Some(text),
        id,
        guard,
        steps: Vec::new(),
        span: span(toks, l, r),
    },
    <l:@L> <mark:OptionMark?> <text:LineText> <id:LineId?> <guard:("if" <Expr>)?> <r:@R> ":" NEWLINE <steps:StepBlock> => ChoiceOption {
        mark,
        text: Some(text),
        id,
        guard,
        steps,
        span: span(toks, l, r),
    },
    <l:@L> "default" <r:@R> ":" NEWLINE <steps:StepBlock> => ChoiceOption {
        mark: Some(OptionMark::Default),
        text: None,
        id: None,
        guard: None,
        steps,
        span: span(toks, l, r),
    },
};

OptionMark: OptionMark = {
    "once" => OptionMark::Once,
    "default" => OptionMark::Default,
};
