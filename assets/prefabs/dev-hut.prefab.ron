        (at: (5, 4, 0), shape: Named(shape: Stairs(facing: South, half: Bottom, corner: Straight), mat: 3)),
        (at: (5, 4, 6), shape: Named(shape: Stairs(facing: North, half: Bottom, corner: Straight), mat: 3)),
