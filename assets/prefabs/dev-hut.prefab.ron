// A 7 x 6 x 7 hut for the debug world. +X east, +Z south; the door is on the south side.
// Layers: y0 floor, y1..3 walls, y4 roof eave ring, y5 upper roof ring and cap.
(
    format: 2,
    name: "dev-hut",
    meta: (author: "mmo", licence: "own work"),
    size: (7, 6, 7),
    anchor: (3, 0, 6),
    palette: ["stone_bricks", "oak_planks", "glass", "spruce_planks"],
    boxes: [
        // floor
        (min: (0, 0, 0), size: (7, 1, 7), mat: 0),
        // walls: north, west, east, south left of the door, south right of the door, lintel
        (min: (0, 1, 0), size: (7, 3, 1), mat: 1),
        (min: (0, 1, 1), size: (1, 3, 5), mat: 1),
        (min: (6, 1, 1), size: (1, 3, 5), mat: 1),
        (min: (0, 1, 6), size: (3, 3, 1), mat: 1),
        (min: (4, 1, 6), size: (3, 3, 1), mat: 1),
        (min: (3, 3, 6), size: (1, 1, 1), mat: 1),
        // windows, west and east
        (min: (0, 2, 3), size: (1, 1, 1), mat: 2),
        (min: (6, 2, 3), size: (1, 1, 1), mat: 2),
        // roof fill under the stair rings
        (min: (1, 4, 1), size: (5, 1, 5), mat: 3),
        (min: (2, 5, 2), size: (3, 1, 3), mat: 3),
    ],
    shaped: [
        (at: (0, 4, 0), shape: Named(shape: Stairs(facing: South, half: Bottom, corner: OuterLeft), mat: 3)),
        (at: (0, 4, 1), shape: Named(shape: Stairs(facing: East, half: Bottom, corner: Straight), mat: 3)),
        (at: (0, 4, 2), shape: Named(shape: Stairs(facing: East, half: Bottom, corner: Straight), mat: 3)),
        (at: (0, 4, 3), shape: Named(shape: Stairs(facing: East, half: Bottom, corner: Straight), mat: 3)),
        (at: (0, 4, 4), shape: Named(shape: Stairs(facing: East, half: Bottom, corner: Straight), mat: 3)),
        (at: (0, 4, 5), shape: Named(shape: Stairs(facing: East, half: Bottom, corner: Straight), mat: 3)),
        (at: (0, 4, 6), shape: Named(shape: Stairs(facing: North, half: Bottom, corner: OuterRight), mat: 3)),
        (at: (1, 4, 0), shape: Named(shape: Stairs(facing: South, half: Bottom, corner: Straight), mat: 3)),
        (at: (1, 4, 6), shape: Named(shape: Stairs(facing: North, half: Bottom, corner: Straight), mat: 3)),
        (at: (2, 4, 0), shape: Named(shape: Stairs(facing: South, half: Bottom, corner: Straight), mat: 3)),
