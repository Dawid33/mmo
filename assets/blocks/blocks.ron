// Block registry. `id` is explicit and STABLE — never renumber an existing
// block; only append. id 0 must be `air` / Untextured. Texture paths are
// relative to assets/blocks/. Faces = per-face (top/side/bottom); the shader
// picks the slot by face normal. Missing textures render as the layer-0
// magenta/black "missing texture" checkerboard.
(
    blocks: [
        // Textures span one BLOCK face (16x16 texels = 1 texel/voxel; see the
        // per-block UV mapping in assets/shaders/voxel_texture.wgsl). To debug
        // UV mapping, point a block at marker.png (asymmetric "F" + red patch
        // at the UV origin).
        (id: 0, name: "air",   textures: Untextured),
        (id: 1, name: "dirt",  textures: All("dirt.png"), hardness: 50, tab: Natural),
        (id: 2, name: "stone", textures: All("stone.png"), hardness: 150, tab: Natural),
        (id: 3, name: "grass", textures: Faces(top: "grass_top.png", side: "grass_side.png", bottom: "dirt.png"), hardness: 60, drop: Item("dirt"), tab: Natural),
        (id: 4, name: "sand",  textures: All("sand.png"), hardness: 50, tab: Natural),
        (id: 5, name: "water", textures: All("water.png"), kind: Liquid, drop: Nothing),
        (id: 6, name: "bedrock",      textures: All("bedrock.png"), tab: Natural),
        (id: 7, name: "sandstone",    textures: All("sandstone.png"), hardness: 150, tab: Natural),
        (id: 8, name: "shale",        textures: All("shale.png"), hardness: 150, tab: Natural),
        (id: 9, name: "limestone",    textures: All("limestone.png"), hardness: 150, tab: Natural),
        (id: 10, name: "conglomerate", textures: All("conglomerate.png"), hardness: 150, tab: Natural),
