        (id: 12, name: "granite",      textures: All("granite.png"), hardness: 200, tab: Natural),
        (id: 13, name: "oak_log",    textures: Faces(top: "oak_rings.png", side: "oak_bark.png", bottom: "oak_rings.png"), collider: Half, hardness: 200, tab: Wood),
        (id: 14, name: "oak_branch", textures: All("oak_branch.png"), collider: Half, hardness: 100, drop: Item("stick"), tab: Wood),
        (id: 15, name: "oak_leaves", textures: All("oak_leaves.png"), solid: false, render: Cutout, hardness: 20, drop: Nothing, tab: Wood),
        (id: 16, name: "pine_log",    textures: Faces(top: "pine_rings.png", side: "pine_bark.png", bottom: "pine_rings.png"), collider: Half, hardness: 200, tab: Wood),
