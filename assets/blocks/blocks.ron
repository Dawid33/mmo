// Block registry. `id` is explicit and STABLE — never renumber an existing
// block; only append. id 0 must be `air` / Untextured. Texture paths are
// relative to assets/blocks/. Faces = per-face (top/side/bottom); the shader
// picks the slot by face normal. Missing textures render as the layer-0
// magenta/black "missing texture" checkerboard.
(
    blocks: [
        // Textures span one BLOCK face (16x16 texels = 1 texel/voxel; see the
        // per-block UV mapping in assets/shaders/voxel_texture.wgsl). To debug
        // UV mapping, point a block at marker.png (asymmetric "F" + red patch
        // at the UV origin).
        (id: 0, name: "air",   textures: Untextured),
        (id: 1, name: "dirt",  textures: All("dirt.png")),
        (id: 2, name: "stone", textures: All("stone.png")),
        (id: 3, name: "grass", textures: Faces(top: "grass_top.png", side: "grass_side.png", bottom: "dirt.png")),
        (id: 4, name: "sand",  textures: All("sand.png")),
        (id: 5, name: "water", textures: All("water.png")),
        (id: 6, name: "bedrock",      textures: All("bedrock.png")),
        (id: 7, name: "sandstone",    textures: All("sandstone.png")),
        (id: 8, name: "shale",        textures: All("shale.png")),
        (id: 9, name: "limestone",    textures: All("limestone.png")),
        (id: 10, name: "conglomerate", textures: All("conglomerate.png")),
        (id: 11, name: "basalt",       textures: All("basalt.png")),
        (id: 12, name: "granite",      textures: All("granite.png")),
        (id: 13, name: "oak_log",    textures: Faces(top: "oak_rings.png", side: "oak_bark.png", bottom: "oak_rings.png"), collider: Half),
        (id: 14, name: "oak_branch", textures: All("oak_branch.png"), collider: Half),
        (id: 15, name: "oak_leaves", textures: All("oak_leaves.png"), solid: false, render: Cutout),
        (id: 16, name: "pine_log",    textures: Faces(top: "pine_rings.png", side: "pine_bark.png", bottom: "pine_rings.png"), collider: Half),
        (id: 17, name: "pine_branch", textures: All("pine_branch.png"), collider: Half),
        (id: 18, name: "pine_leaves", textures: All("pine_leaves.png"), solid: false, render: Cutout),
        (id: 19, name: "birch_log",    textures: Faces(top: "birch_rings.png", side: "birch_bark.png", bottom: "birch_rings.png"), collider: Half),
        (id: 20, name: "birch_branch", textures: All("birch_branch.png"), collider: Half),
        (id: 21, name: "birch_leaves", textures: All("birch_leaves.png"), solid: false, render: Cutout),
        (id: 22, name: "snow", textures: All("snow.png")),
        (id: 23, name: "ice", textures: All("ice.png")),
        (id: 24, name: "glacier_ice", textures: All("glacier_ice.png")),
        (id: 25, name: "mud", textures: All("mud.png")),
        (id: 26, name: "peat", textures: All("peat.png")),
        (id: 27, name: "gravel", textures: All("gravel.png")),
        (id: 28, name: "red_sand", textures: All("red_sand.png")),
        (id: 29, name: "dry_grass", textures: Faces(top: "dry_grass_top.png", side: "dry_grass_side.png", bottom: "dirt.png")),
        (id: 30, name: "podzol", textures: Faces(top: "podzol_top.png", side: "podzol_side.png", bottom: "dirt.png")),
        (id: 31, name: "frozen_dirt", textures: All("frozen_dirt.png")),
        (id: 32, name: "salt", textures: All("salt.png")),
        (id: 33, name: "spruce_log", textures: Faces(top: "spruce_rings.png", side: "spruce_bark.png", bottom: "spruce_rings.png"), collider: Half),
        (id: 34, name: "spruce_branch", textures: All("spruce_branch.png"), collider: Half),
        (id: 35, name: "spruce_leaves", textures: All("spruce_leaves.png"), solid: false, render: Cutout),
        (id: 36, name: "acacia_log", textures: Faces(top: "acacia_rings.png", side: "acacia_bark.png", bottom: "acacia_rings.png"), collider: Half),
        (id: 37, name: "acacia_branch", textures: All("acacia_branch.png"), collider: Half),
        (id: 38, name: "acacia_leaves", textures: All("acacia_leaves.png"), solid: false, render: Cutout),
        (id: 39, name: "palm_log", textures: Faces(top: "palm_rings.png", side: "palm_bark.png", bottom: "palm_rings.png"), collider: Half),
        (id: 40, name: "palm_branch", textures: All("palm_branch.png"), collider: Half),
        (id: 41, name: "palm_leaves", textures: All("palm_leaves.png"), solid: false, render: Cutout),
        (id: 42, name: "jungle_log", textures: Faces(top: "jungle_rings.png", side: "jungle_bark.png", bottom: "jungle_rings.png"), collider: Half),
        (id: 43, name: "jungle_branch", textures: All("jungle_branch.png"), collider: Half),
        (id: 44, name: "jungle_leaves", textures: All("jungle_leaves.png"), solid: false, render: Cutout),
        (id: 45, name: "cactus", textures: All("cactus.png"), collider: Half),
    ],
)
