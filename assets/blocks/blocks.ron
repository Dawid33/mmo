// Block registry. `id` is explicit and STABLE — never renumber an existing
// block; only append. id 0 must be `air` / Untextured. Texture paths are
// relative to assets/blocks/. Faces = per-face (top/side/bottom); the shader
// picks the slot by face normal. Missing textures render as the layer-0
// magenta/black "missing texture" checkerboard.
(
    blocks: [
        // Textures span one BLOCK face (16x16 texels = 1 texel/voxel; see the
        // per-block UV mapping in assets/shaders/voxel_texture.wgsl). To debug
        // UV mapping, point a block at marker.png (asymmetric "F" + red patch
        // at the UV origin).
        (id: 0, name: "air",   textures: Untextured),
        (id: 1, name: "dirt",  textures: All("dirt.png")),
        (id: 2, name: "stone", textures: All("stone.png")),
        (id: 3, name: "grass", textures: Faces(top: "grass_top.png", side: "grass_side.png", bottom: "dirt.png")),
        (id: 4, name: "sand",  textures: All("sand.png")),
        (id: 5, name: "water", textures: All("water.png")),
        (id: 6, name: "bedrock",      textures: All("bedrock.png")),
        (id: 7, name: "sandstone",    textures: All("sandstone.png")),
        (id: 8, name: "shale",        textures: All("shale.png")),
        (id: 9, name: "limestone",    textures: All("limestone.png")),
        (id: 10, name: "conglomerate", textures: All("conglomerate.png")),
        (id: 11, name: "basalt",       textures: All("basalt.png")),
        (id: 12, name: "granite",      textures: All("granite.png")),
        (id: 13, name: "oak_log",    textures: Faces(top: "oak_rings.png", side: "oak_bark.png", bottom: "oak_rings.png")),
        (id: 14, name: "oak_branch", textures: All("oak_branch.png")),
        (id: 15, name: "oak_leaves", textures: All("oak_leaves.png"), solid: false, render: Cutout),
        (id: 16, name: "pine_log",    textures: Faces(top: "pine_rings.png", side: "pine_bark.png", bottom: "pine_rings.png")),
        (id: 17, name: "pine_branch", textures: All("pine_branch.png")),
        (id: 18, name: "pine_leaves", textures: All("pine_leaves.png"), solid: false, render: Cutout),
        (id: 19, name: "birch_log",    textures: Faces(top: "birch_rings.png", side: "birch_bark.png", bottom: "birch_rings.png")),
        (id: 20, name: "birch_branch", textures: All("birch_branch.png")),
        (id: 21, name: "birch_leaves", textures: All("birch_leaves.png"), solid: false, render: Cutout),
    ],
)
